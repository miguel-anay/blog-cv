---
import BaseHead from '../../components/seo/BaseHead.astro';
import Header from '../../components/layout/Header.astro';
import Footer from '../../components/layout/Footer.astro';
import { DOC_REPOS } from '../../features/docs/repos';
---

<!doctype html>
<html lang="es">
  <head>
    <BaseHead title="Docs — Miguel Anay" description="Documentación de mis proyectos, publicada directo desde cada repositorio de GitHub." />
  </head>
  <body>
    <Header />

    <main>
      <section class="page-head">
        <div class="page-head__inner">
          <p class="page-head__eyebrow">Documentación</p>
          <h1 class="page-head__title">Docs de mis proyectos</h1>
          <p class="page-head__lead">Guías y referencia de cada proyecto, publicadas directo desde su repositorio en GitHub.</p>
        </div>
      </section>

      <section class="repos" aria-label="Proyectos documentados">
        {DOC_REPOS.map((r) => (
          <a href={`/docs/${r.repo}`} class="repo">
            <span class="repo__title">{r.title}</span>
            <span class="repo__desc">{r.description}</span>
            <span class="repo__foot">
              <span class="repo__stack">{r.stack}</span>
              <span class="repo__cta">Leer docs →</span>
            </span>
          </a>
        ))}
      </section>
    </main>

    <Footer />

    <style>
      .repos {
        max-width: var(--max-w);
        margin: 0 auto;
        padding: 40px var(--pad-x) 0;
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
        gap: 16px;
      }
      /* Mintlify card-base */
      .repo {
        display: flex;
        flex-direction: column;
        gap: 8px;
        padding: 24px;
        border: 1px solid var(--border);
        border-radius: var(--radius-lg);
        background: var(--bg-raised);
        color: var(--text);
        transition: border-color 0.15s ease, box-shadow 0.15s ease;
      }
      .repo:hover { border-color: var(--border-strong); box-shadow: var(--shadow-subtle); color: var(--text); }
      .repo__title { font-size: var(--fs-h5); font-weight: 600; color: var(--text-strong); }
      .repo__desc { font-size: var(--fs-sm); line-height: 1.5; color: var(--text-muted); flex: 1; }
      .repo__foot { display: flex; justify-content: space-between; align-items: center; gap: 12px; margin-top: 8px; }
      .repo__stack { font-family: var(--font-mono); font-size: var(--fs-micro); color: var(--text-dim); }
      .repo__cta { font-size: var(--fs-sm); font-weight: 500; color: var(--text-strong); }

      @media (max-width: 767px) {
        .repos { grid-template-columns: minmax(0, 1fr); }
      }
    </style>
  </body>
</html>
