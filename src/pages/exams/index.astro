---
import BaseHead from '../../components/seo/BaseHead.astro';
import Header from '../../components/layout/Header.astro';
import Footer from '../../components/layout/Footer.astro';
import ExamCard from '../../features/exams/components/ExamCard.astro';
import { getExams } from '../../lib/exam-api';

const exams = await getExams();
---

<!doctype html>
<html lang="es">
  <head>
    <BaseHead
      title="Certificaciones — Miguel Anay"
      description={`${exams.length} exámenes de certificación sobre desarrollo de software, arquitectura y herramientas.`}
    />
  </head>
  <body>
    <Header />

    <main>
      <section class="page-head">
        <div class="page-head__inner">
          <p class="page-head__eyebrow">Certificaciones</p>
          <h1 class="page-head__title">
            {exams.length} {exams.length === 1 ? 'examen' : 'exámenes'}
          </h1>
          <p class="page-head__lead">Ponte a prueba con exámenes cronometrados y revisa tus resultados al terminar.</p>
        </div>
      </section>

      <section class="exams-section">
        <div class="exams-inner">
          {exams.length === 0 ? (
            <p class="empty">No hay exámenes publicados todavía.</p>
          ) : (
            <div class="exam-grid">
              {exams.map((exam) => (
                <ExamCard
                  title={exam.title}
                  description={exam.description}
                  slug={exam.slug}
                  level={exam.level}
                  questionCount={exam.questionCount}
                  timeLimitSeconds={exam.timeLimitSeconds}
                />
              ))}
            </div>
          )}
        </div>
      </section>
    </main>

    <Footer />

    <style>
      .exams-inner {
        max-width: var(--max-w);
        margin: 0 auto;
        padding: 40px var(--pad-x) 80px;
      }

      .exam-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(min(100%, 300px), 1fr));
        gap: 16px;
      }

      .empty {
        font-size: var(--fs-md);
        color: var(--text-dim);
        padding: 48px 0;
        margin: 0;
      }
    </style>
  </body>
</html>
