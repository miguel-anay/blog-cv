---
import BaseHead from '../../components/seo/BaseHead.astro';
import Header from '../../components/layout/Header.astro';
import Footer from '../../components/layout/Footer.astro';
import { getExamBySlug, getAttemptHistory } from '../../lib/exam-api';
import { formatHms } from '../../features/exams/lib/timer';

const { slug } = Astro.params;
if (!slug) return Astro.redirect('/exams');

// Defensive — the middleware sets a guest user on /exams, but a page-level check keeps
// this page correct even if the gating prefix list ever changes (REQ-001).
const user = Astro.locals.user;
if (!user) return new Response('Visitor id unavailable', { status: 500 });

const exam = await getExamBySlug(slug);
if (!exam) return new Response(null, { status: 404, statusText: 'Not Found' });

const history = await getAttemptHistory(exam.id, user.id);

const levelLabel: Record<string, string> = {
  beginner: 'principiante',
  intermediate: 'intermedio',
  advanced: 'avanzado',
};

const fmt = (d: Date) =>
  d.toLocaleDateString('es-PE', { year: 'numeric', month: '2-digit', day: '2-digit' });
---

<!doctype html>
<html lang="es">
  <head>
    <BaseHead title={`${exam.title} — Certificaciones`} description={exam.description} />
  </head>
  <body>
    <Header />

    <main>
      <section class="exam-head">
        <div class="exam-head__inner">
          <nav class="breadcrumb" aria-label="Ruta">
            <a href="/exams" class="breadcrumb__back">← Exámenes</a>
          </nav>

          <div class="exam-meta">
            <span class="exam-level">{levelLabel[exam.level] ?? exam.level}</span>
            <span class="exam-sep">·</span>
            <span>{exam.questionCount} {exam.questionCount === 1 ? 'pregunta' : 'preguntas'}</span>
            <span class="exam-sep">·</span>
            <span>{formatHms(exam.timeLimitSeconds)}</span>
            <span class="exam-sep">·</span>
            <span>{exam.passScorePercent}% para aprobar</span>
          </div>

          <h1 class="exam-title">{exam.title}</h1>
          <p class="exam-description">{exam.description}</p>

          {exam.coverUrl && (
            <img src={exam.coverUrl} alt={exam.title} class="exam-cover" loading="eager" />
          )}

          <form method="post" action="/api/exams/attempts" class="start-form">
            <input type="hidden" name="examId" value={exam.id} />
            <button type="submit" class="btn-accent start-button">Comenzar examen</button>
          </form>
        </div>
      </section>

      <section class="history-section">
        <div class="history-inner">
          <h2 class="history-title">Tus intentos</h2>

          {history.length === 0 ? (
            <p class="empty">Todavía no tenés intentos para este examen.</p>
          ) : (
            <ul class="history-list">
              {history.map((attempt) => (
                <li class="history-item">
                  <span class="history-item__date">{fmt(attempt.startedAt)}</span>
                  <span class="history-item__sep">·</span>
                  {attempt.submittedAt ? (
                    <>
                      <span class="history-item__score">{attempt.score}%</span>
                      <span class="history-item__detail">
                        ({attempt.correctCount}/{attempt.totalQuestions} correctas)
                      </span>
                      {attempt.autoSubmitted && (
                        <span class="history-item__auto">Enviado automáticamente</span>
                      )}
                    </>
                  ) : (
                    <span class="history-item__pending">En progreso</span>
                  )}
                </li>
              ))}
            </ul>
          )}
        </div>
      </section>
    </main>

    <Footer />

    <style>
      .exam-head {
        border-bottom: 1px solid var(--border-dim);
      }
      .exam-head__inner {
        max-width: var(--max-w);
        margin: 0 auto;
        padding: 40px var(--pad-x) 48px;
      }

      .breadcrumb { margin-bottom: 24px; }
      .breadcrumb__back {
        font-size: var(--fs-sm);
        font-weight: 500;
        color: var(--text-muted);
        text-decoration: none;
      }
      .breadcrumb__back:hover { color: var(--text-strong); }

      .exam-meta {
        display: flex;
        align-items: center;
        flex-wrap: wrap;
        gap: 8px;
        font-size: var(--fs-caption);
        color: var(--text-muted);
        margin-bottom: 12px;
      }
      .exam-level {
        font-size: var(--fs-micro);
        font-weight: 500;
        color: var(--text-muted);
        background: var(--bg-sunken);
        border: 1px solid var(--border);
        border-radius: var(--radius-full);
        padding: 2px 10px;
      }
      .exam-sep { color: var(--text-faint); }

      .exam-title {
        font-size: var(--fs-h2);
        font-weight: 600;
        line-height: 1.2;
        letter-spacing: -0.5px;
        color: var(--text-strong);
        margin: 0 0 12px;
        max-width: 860px;
      }

      .exam-description {
        font-size: var(--fs-lg);
        color: var(--text-muted);
        line-height: 1.5;
        margin: 0;
        max-width: 680px;
      }

      .exam-cover {
        width: 100%;
        max-width: 860px;
        height: auto;
        border-radius: var(--radius-lg);
        margin-top: 32px;
        border: 1px solid var(--border);
        object-fit: cover;
      }

      .start-form { margin-top: 28px; }
      .start-button {
        border: none;
        cursor: pointer;
        font-family: inherit;
        transition: opacity 0.15s ease;
      }
      .start-button:hover { opacity: 0.88; }

      .history-inner {
        max-width: var(--max-w);
        margin: 0 auto;
        padding: 40px var(--pad-x) 96px;
      }

      .history-title {
        font-size: var(--fs-h4);
        font-weight: 600;
        letter-spacing: -0.01em;
        color: var(--text-strong);
        margin: 0 0 16px;
      }

      .history-list {
        list-style: none;
        margin: 0;
        padding: 0;
        display: flex;
        flex-direction: column;
        gap: 8px;
        max-width: 720px;
      }

      .history-item {
        display: flex;
        align-items: center;
        flex-wrap: wrap;
        gap: 8px;
        font-size: var(--fs-sm);
        color: var(--text-muted);
        border: 1px solid var(--border);
        border-radius: var(--radius-lg);
        padding: 12px 16px;
      }
      .history-item__date { color: var(--text-strong); font-variant-numeric: tabular-nums; }
      .history-item__sep { color: var(--text-faint); }
      .history-item__score { color: var(--text-strong); font-weight: 600; }
      .history-item__detail { color: var(--text-muted); }
      .history-item__pending { color: var(--text-dim); }
      .history-item__auto { color: var(--text-dim); font-size: var(--fs-caption); }

      .empty {
        font-size: var(--fs-md);
        color: var(--text-dim);
        padding: 8px 0;
        margin: 0;
      }
    </style>
  </body>
</html>
