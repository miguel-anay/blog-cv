---
import BaseHead from "../../../components/seo/BaseHead.astro";
import Header from "../../../components/layout/Header.astro";
import Footer from "../../../components/layout/Footer.astro";
import BlogCard from "../components/BlogCard.astro";
import { getArticles, getCategories } from "../../../lib/api";

const { slug } = Astro.params;
if (!slug) return Astro.redirect('/blog/categories');

const [allCategories, articlesRes] = await Promise.all([
  getCategories(),
  getArticles({ category: slug, pageSize: 100 }),
]);

const category = allCategories.find((c) => c.slug === slug);
if (!category) return new Response(null, { status: 404, statusText: 'Not Found' });

const posts = articlesRes.data.sort(
  (a, b) =>
    new Date(b.publishedAt ?? b.createdAt).getTime() -
    new Date(a.publishedAt ?? a.createdAt).getTime()
);

const dates = posts
  .map((p) => new Date(p.publishedAt ?? p.createdAt))
  .sort((a, b) => a.getTime() - b.getTime());
const first = dates[0] ? dates[0].toISOString().slice(0, 10) : '—';
const last = dates[dates.length - 1] ? dates[dates.length - 1].toISOString().slice(0, 10) : '—';
---

<!doctype html>
<html lang="es">
  <head>
    <BaseHead
      title={`${category.name} — Blog Miguel Anay`}
      description={category.description || `${posts.length} escritos sobre ${category.name}.`}
    />
  </head>
  <body>
    <Header />

    <main>
      <section class="page-head">
        <div class="page-head__inner">
          <nav class="crumbs" aria-label="Ruta">
            <a href="/blog">Blog</a>
            <span aria-hidden="true">/</span>
            <a href="/blog/categories">Categorías</a>
          </nav>

          <h1 class="page-head__title">{category.name}</h1>
          {category.description && <p class="page-head__lead">{category.description}</p>}

          <dl class="cat-stats">
            <div class="stat">
              <dt class="stat__k">Artículos</dt>
              <dd class="stat__v">{posts.length}</dd>
            </div>
            <div class="stat">
              <dt class="stat__k">Primero</dt>
              <dd class="stat__v">{first}</dd>
            </div>
            <div class="stat">
              <dt class="stat__k">Último</dt>
              <dd class="stat__v">{last}</dd>
            </div>
          </dl>
        </div>
      </section>

      <section class="posts">
        <div class="posts-inner">
          <div class="posts-head">
            <span class="posts-count">Todos los artículos de {category.name}</span>
          </div>

          {posts.length > 0 ? (
            <ol class="post-list">
              {posts.map((post, i) => (
                <BlogCard
                  title={post.title}
                  description={post.description ?? ''}
                  pubDate={new Date(post.publishedAt ?? post.createdAt)}
                  slug={post.slug}
                  index={i + 1}
                  readMin={post.readMin ?? 1}
                  categories={post.categories}
                />
              ))}
            </ol>
          ) : (
            <p class="cat-empty">Aún no hay artículos en esta categoría.</p>
          )}
        </div>
      </section>
    </main>

    <Footer />

    <style>
      .crumbs {
        display: flex;
        flex-wrap: wrap;
        gap: 6px;
        font-size: var(--fs-caption);
        color: var(--text-faint);
        margin-bottom: 12px;
      }
      .crumbs a { color: var(--text-muted); }
      .crumbs a:hover { color: var(--text-strong); }

      .cat-stats {
        margin: 24px 0 0;
        display: flex;
        gap: 12px;
        flex-wrap: wrap;
      }
      .stat {
        display: flex;
        flex-direction: column;
        gap: 4px;
        padding: 12px 16px;
        border: 1px solid var(--border);
        border-radius: var(--radius-lg);
        background: var(--bg-raised);
        min-width: 120px;
      }
      .stat__k { font-size: var(--fs-micro); color: var(--text-dim); margin: 0; }
      .stat__v { font-size: var(--fs-md); font-weight: 600; color: var(--text-strong); margin: 0; }

      .posts-inner { max-width: var(--max-w); margin: 0 auto; padding: 32px var(--pad-x) var(--section-pad-y); }
      .posts-head { margin-bottom: 8px; }
      .posts-count { font-size: var(--fs-caption); color: var(--text-dim); }
      .post-list { list-style: none; padding: 0; margin: 0; }

      .cat-empty {
        color: var(--text-muted);
        padding: 48px 0;
        font-size: var(--fs-sm);
        margin: 0;
      }
    </style>
  </body>
</html>
