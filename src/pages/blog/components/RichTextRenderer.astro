---
// Renders article body blocks - used only in blog feature
import type { TextNode } from "../../../lib/api-types";
import DiagramBlock from "../../../features/blog/components/DiagramBlock.astro";

export interface Props {
  blocks?: any[];
}

const { blocks = [] } = Astro.props;

const processedBlocks = blocks;

// Helper function to render text nodes with formatting (similar to DynamicContent.astro)
function renderTextNode(node: TextNode) {
  let text = node.text;
  let className = "";

  if (node.bold) className += "font-bold ";
  if (node.italic) className += "italic ";
  if (node.underline) className += "underline ";
  if (node.strikethrough) className += "line-through ";
  if (node.code) className += "inline-code ";

  return { text, className: className.trim() };
}

// Helper function to check if a node is a link
function isLinkNode(node: any): boolean {
  return node.type === "link" && node.url && node.children;
}
---

<!-- Image Modal -->
<div id="imageModal" class="image-modal" aria-hidden="true">
  <div class="image-modal-overlay"></div>
  <div class="image-modal-content">
    <button class="image-modal-close" aria-label="Cerrar modal">
      <svg
        xmlns="http://www.w3.org/2000/svg"
        fill="none"
        viewBox="0 0 24 24"
        stroke="currentColor"
        width="24"
        height="24">
        <path
          stroke-linecap="round"
          stroke-linejoin="round"
          stroke-width="2"
          d="M6 18L18 6M6 6l12 12"></path>
      </svg>
    </button>
    <img id="modalImage" src="" alt="" class="image-modal-img" />
    <div id="modalCaption" class="image-modal-caption"></div>
  </div>
</div>

<div class="rich-content">
  {
    processedBlocks.map((block) => {
      // Handle paragraph blocks (type: 'paragraph')
      if (block.type === "paragraph") {
        return (
          <p class="paragraph-block">
            {block.children?.map((child: any) => {
              // Check if the child is a link node
              if (isLinkNode(child)) {
                return (
                  <a
                    href={child.url}
                    class="inline-link"
                    target="_blank"
                    rel="noopener noreferrer">
                    {child.children?.map((textNode: TextNode) => {
                      const { text, className } = renderTextNode(textNode);
                      return className ? (
                        <span class={className}>{text}</span>
                      ) : (
                        text
                      );
                    })}
                  </a>
                );
              }
              // Otherwise, render as regular text node
              const { text, className } = renderTextNode(child);
              return className ? <span class={className}>{text}</span> : text;
            })}
          </p>
        );
      }

      // Handle list blocks (type: 'list')
      if (block.type === "list") {
        const ListTag = block.format === "ordered" ? "ol" : "ul";
        return (
          <ListTag
            class={`list-block ${block.format === "ordered" ? "ordered" : "unordered"}`}>
            {block.children?.map((item: any) => (
              <li>
                {item.children?.map((textNode: TextNode) => {
                  const { text, className } = renderTextNode(textNode);
                  return className ? (
                    <span class={className}>{text}</span>
                  ) : (
                    text
                  );
                })}
              </li>
            ))}
          </ListTag>
        );
      }

      // Handle code blocks (type: 'code')
      if (block.type === "code") {
        const language = block.language?.toLowerCase() || "code";
        const isTypeScript = language === "typescript" || language === "ts";
        const codeContent = block.code || block.children?.[0]?.text || "";

        return (
          <div class={`code-block ${isTypeScript ? "typescript-block" : ""}`}>
            <div class="code-block-header">
              <span class="code-block-language">
                {isTypeScript ? "TypeScript" : block.language || "Code"}
              </span>
              <svg
                class="code-block-icon"
                fill="none"
                stroke="currentColor"
                viewBox="0 0 24 24">
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M10 20l4-16m4 4l4 4-4 4M6 16l-4-4 4-4"
                />
              </svg>
            </div>
            <div class="code-block-body">
              <pre>
                <code class={`language-${language}`}>{codeContent}</code>
              </pre>
            </div>
          </div>
        );
      }

      // Handle image blocks (type: 'image')
      if (block.type === "image") {
        const imageUrl = block.image?.url || block.url;
        const imageAlt =
          block.image?.alternativeText || block.alternativeText || "";
        const imageCaption = block.image?.caption || block.caption;

        return (
          <figure class="image-block">
            <img
              src={imageUrl}
              alt={imageAlt}
              loading="lazy"
              class="image-block-img"
              data-modal-trigger
            />
            {imageCaption && <figcaption>{imageCaption}</figcaption>}
          </figure>
        );
      }

      // Handle heading blocks (type: 'heading')
      if (block.type === "heading") {
        const HeadingTag = `h${block.level}` as any;
        return (
          <HeadingTag class="heading-block">
            {block.children?.map((textNode: TextNode) => {
              const { text, className } = renderTextNode(textNode);
              return className ? <span class={className}>{text}</span> : text;
            })}
          </HeadingTag>
        );
      }

      // Handle link blocks (type: 'link')
      if (block.type === "link") {
        return (
          <a
            href={block.url}
            class="link-block"
            target="_blank"
            rel="noopener noreferrer">
            {block.children?.map((textNode: TextNode) => {
              const { text, className } = renderTextNode(textNode);
              return className ? <span class={className}>{text}</span> : text;
            })}
          </a>
        );
      }

      // Handle Strapi components (shared.*)
      switch (block.__component) {
        case "shared.rich-text":
          return <div class="rich-text-block" set:html={block.body} />;

        case "shared.quote":
          return (
            <blockquote class="quote-block">
              <p>{block.body}</p>
              {block.title && <cite>— {block.title}</cite>}
            </blockquote>
          );

        case "shared.media":
          return (
            <figure class="media-block">
              <img
                src={block.file?.url}
                alt={block.file?.alternativeText || ""}
                loading="lazy"
              />
              {block.file?.caption && (
                <figcaption>{block.file.caption}</figcaption>
              )}
            </figure>
          );

        case "shared.slider":
          return (
            <div class="slider-block">
              {block.files?.map((file: any) => (
                <img
                  src={file.url}
                  alt={file.alternativeText || ""}
                  loading="lazy"
                />
              ))}
            </div>
          );

        case "shared.code":
          const language = block.language?.toLowerCase() || "code";
          const isTypeScript = language === "typescript" || language === "ts";

          return (
            <div class={`code-block ${isTypeScript ? "typescript-block" : ""}`}>
              <div class="code-block-header">
                <span class="code-block-language">
                  {isTypeScript ? "TypeScript" : block.language || "Code"}
                </span>
                <svg
                  class="code-block-icon"
                  fill="none"
                  stroke="currentColor"
                  viewBox="0 0 24 24">
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2"
                    d="M10 20l4-16m4 4l4 4-4 4M6 16l-4-4 4-4"
                  />
                </svg>
              </div>
              <div class="code-block-body">
                <pre>
                  <code class={`language-${language}`}>{block.code}</code>
                </pre>
              </div>
            </div>
          );

        case "shared.diagram":
          return (
            <DiagramBlock
              svg={block.svg}
              alternativeText={block.alternativeText}
              caption={block.caption}
              steps={block.steps}
              loop={block.loop}
            />
          );

        default:
          return null;
      }
    })
  }
</div>

<style>
  .rich-content {
    line-height: 1.7;
    color: var(--text);
  }

  /* Text formatting utilities */
  .font-bold { font-weight: 600; color: var(--text-strong); }
  .italic { font-style: italic; }
  .underline { text-decoration: underline; }
  .line-through { text-decoration: line-through; }

  .inline-code {
    background: var(--bg-sunken);
    color: var(--text-strong);
    border: 1px solid var(--border);
    padding: 1px 6px;
    border-radius: var(--radius-xs);
    font-family: var(--font-mono);
    font-size: var(--fs-caption);
    overflow-wrap: anywhere;
  }

  .paragraph-block {
    margin: 1.25rem 0;
    font-size: var(--fs-md);
    line-height: 1.7;
    color: var(--text);
  }

  .link-block,
  .inline-link {
    color: var(--link);
    font-weight: 500;
    text-decoration: underline;
    text-underline-offset: 3px;
    text-decoration-thickness: 1px;
  }
  .link-block:hover,
  .inline-link:hover { text-decoration-thickness: 2px; }

  .heading-block {
    margin-top: 2.5rem;
    margin-bottom: 0.75rem;
    line-height: 1.3;
    color: var(--text-strong);
    font-weight: 600;
    letter-spacing: -0.01em;
    scroll-margin-top: 80px;
  }
  h1.heading-block { font-size: var(--fs-h3); }
  h2.heading-block { font-size: var(--fs-h4); }
  h3.heading-block { font-size: var(--fs-h5); }
  h4.heading-block,
  h5.heading-block,
  h6.heading-block { font-size: var(--fs-md); }

  .list-block {
    margin: 1.25rem 0;
    padding-left: 1.5rem;
    color: var(--text);
  }
  .list-block.ordered { list-style-type: decimal; }
  .list-block.unordered { list-style-type: disc; }
  .list-block li {
    margin: 0.5rem 0;
    font-size: var(--fs-md);
    line-height: 1.7;
  }
  .list-block li::marker { color: var(--text-dim); }

  /* Images */
  .image-block,
  .media-block {
    margin: 2rem 0;
    text-align: center;
  }
  .image-block-img,
  .media-block img {
    max-width: 100%;
    height: auto;
    border-radius: var(--radius-lg);
    border: 1px solid var(--border);
  }
  .image-block-img { cursor: zoom-in; }
  .image-block figcaption,
  .media-block figcaption {
    margin-top: 0.75rem;
    font-size: var(--fs-caption);
    color: var(--text-dim);
  }

  /* Image modal (always on a dark overlay, so fixed light-on-dark colors) */
  .image-modal {
    display: none;
    position: fixed;
    inset: 0;
    z-index: 9999;
    align-items: center;
    justify-content: center;
    padding: 1rem;
  }
  .image-modal[aria-hidden="false"] { display: flex; }
  .image-modal-overlay {
    position: absolute;
    inset: 0;
    background: rgba(0, 0, 0, 0.85);
    backdrop-filter: blur(4px);
    animation: fadeIn 0.2s ease;
  }
  .image-modal-content {
    position: relative;
    z-index: 10000;
    max-width: 95%;
    max-height: 95%;
    display: flex;
    flex-direction: column;
    align-items: center;
    animation: zoomIn 0.2s ease;
  }
  .image-modal-close {
    position: absolute;
    top: -3rem;
    right: 0;
    background: rgba(255, 255, 255, 0.1);
    border: 1px solid rgba(255, 255, 255, 0.3);
    border-radius: var(--radius-full);
    width: 40px;
    height: 40px;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    color: #fff;
    padding: 0;
    transition: background 0.15s ease;
  }
  .image-modal-close:hover { background: rgba(255, 255, 255, 0.2); }
  .image-modal-img {
    max-width: 100%;
    max-height: 85vh;
    height: auto;
    border-radius: var(--radius-md);
    object-fit: contain;
  }
  .image-modal-caption {
    margin-top: 1rem;
    padding: 8px 16px;
    background: var(--bg-raised);
    color: var(--text);
    border-radius: var(--radius-full);
    font-size: var(--fs-caption);
    max-width: 600px;
    text-align: center;
    display: none;
  }
  .image-modal-caption:not(:empty) { display: block; }

  @keyframes fadeIn { from { opacity: 0; } to { opacity: 1; } }
  @keyframes zoomIn { from { opacity: 0; transform: scale(0.96); } to { opacity: 1; transform: scale(1); } }

  /* Raw HTML rich-text blocks */
  .rich-text-block { margin: 1.25rem 0; }
  .rich-text-block :global(h1),
  .rich-text-block :global(h2),
  .rich-text-block :global(h3) {
    margin-top: 2.5rem;
    margin-bottom: 0.75rem;
    line-height: 1.3;
    font-weight: 600;
    color: var(--text-strong);
  }
  .rich-text-block :global(h1) { font-size: var(--fs-h3); }
  .rich-text-block :global(h2) { font-size: var(--fs-h4); }
  .rich-text-block :global(h3) { font-size: var(--fs-h5); }
  .rich-text-block :global(p) { margin: 1rem 0; color: var(--text); }
  .rich-text-block :global(ul),
  .rich-text-block :global(ol) {
    margin: 1rem 0;
    padding-left: 1.5rem;
    color: var(--text);
  }
  .rich-text-block :global(ul) { list-style: disc; }
  .rich-text-block :global(ol) { list-style: decimal; }
  .rich-text-block :global(li) { margin: 0.5rem 0; }
  .rich-text-block :global(a) {
    color: var(--link);
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  .rich-text-block :global(code) {
    background: var(--bg-sunken);
    border: 1px solid var(--border);
    padding: 1px 6px;
    border-radius: var(--radius-xs);
    font-family: var(--font-mono);
    font-size: var(--fs-caption);
  }
  .rich-text-block :global(pre) {
    background: var(--code-bg);
    color: var(--code-text);
    padding: 16px 20px;
    border-radius: var(--radius-md);
    overflow-x: auto;
    margin: 1.5rem 0;
    font-family: var(--font-mono);
    font-size: var(--fs-sm);
    line-height: 1.6;
  }
  .rich-text-block :global(pre code) {
    background: none;
    border: 0;
    padding: 0;
    color: inherit;
    font-size: inherit;
  }

  .quote-block {
    margin: 2rem 0;
    padding: 4px 0 4px 20px;
    border-left: 2px solid var(--border-strong);
    font-size: var(--fs-lg);
    line-height: 1.6;
    color: var(--text-muted);
  }
  .quote-block p { margin: 0 0 0.5rem 0; }
  .quote-block cite {
    font-size: var(--fs-sm);
    color: var(--text-dim);
    font-style: normal;
  }

  .slider-block {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
    gap: 12px;
    margin: 2rem 0;
  }
  .slider-block img {
    width: 100%;
    height: 200px;
    object-fit: cover;
    border-radius: var(--radius-lg);
    border: 1px solid var(--border);
  }

  /* Code blocks: dark in both modes (Mintlify code surface) */
  .code-block {
    margin: 1.75rem 0;
    border-radius: var(--radius-md);
    overflow: hidden;
    background: var(--code-bg);
    color: var(--code-text);
  }
  .code-block-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 8px 16px;
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
  }
  .code-block-language {
    font-family: var(--font-sans);
    font-size: var(--fs-micro);
    font-weight: 500;
    color: rgba(255, 255, 255, 0.6);
  }
  /* ponytail: TypeScript keeps a semantic blue label, nothing more */
  .typescript-block .code-block-language { color: #6ea8f7; }
  .code-block-icon {
    width: 16px;
    height: 16px;
    color: rgba(255, 255, 255, 0.4);
  }
  .code-block-body {
    padding: 16px 20px;
    overflow: auto;
    max-height: 600px;
  }
  .code-block-body pre {
    margin: 0;
    font-family: var(--font-mono);
    font-size: var(--fs-sm);
    line-height: 1.6;
    background: transparent;
    padding: 0;
    white-space: pre;
    word-wrap: normal;
    tab-size: 2;
  }
  .code-block-body code {
    background: transparent;
    border: 0;
    padding: 0;
    border-radius: 0;
    color: var(--code-text);
    font-family: inherit;
    font-size: inherit;
    display: block;
    white-space: pre;
    word-spacing: normal;
    word-break: normal;
    word-wrap: normal;
    tab-size: 2;
    hyphens: none;
  }
  .code-block-body::-webkit-scrollbar { height: 8px; width: 8px; }
  .code-block-body::-webkit-scrollbar-track { background: transparent; }
  .code-block-body::-webkit-scrollbar-thumb {
    background: rgba(255, 255, 255, 0.18);
    border-radius: var(--radius-full);
  }
  .code-block-body::-webkit-scrollbar-corner { background: transparent; }

  @media (max-width: 720px) {
    .slider-block { grid-template-columns: 1fr; }
    .code-block-body { padding: 12px 14px; max-height: 400px; }
    .code-block-body pre { font-size: var(--fs-caption); }
    .image-modal-close { top: -2.5rem; width: 36px; height: 36px; }
    .image-modal-img { max-height: 80vh; }
    .image-modal-caption { max-width: 90%; }
  }
</style>

<script>
  // Image Modal Functionality
  document.addEventListener("DOMContentLoaded", () => {
    const modal = document.getElementById("imageModal");
    const modalImage = document.getElementById("modalImage");
    const modalCaption = document.getElementById("modalCaption");
    const closeButton = modal?.querySelector(".image-modal-close");
    const overlay = modal?.querySelector(".image-modal-overlay");

    // Open modal when clicking on images with data-modal-trigger
    document.querySelectorAll("[data-modal-trigger]").forEach((img) => {
      img.addEventListener("click", () => {
        if (modal && modalImage && modalCaption) {
          const src = img.getAttribute("src") || "";
          const alt = img.getAttribute("alt") || "";
          const caption =
            img.parentElement?.querySelector("figcaption")?.textContent || "";

          modalImage.setAttribute("src", src);
          modalImage.setAttribute("alt", alt);
          modalCaption.textContent = caption;

          modal.setAttribute("aria-hidden", "false");
          document.body.style.overflow = "hidden";
        }
      });
    });

    // Close modal function
    const closeModal = () => {
      if (modal) {
        modal.setAttribute("aria-hidden", "true");
        document.body.style.overflow = "";
      }
    };

    // Close modal on button click
    closeButton?.addEventListener("click", closeModal);

    // Close modal on overlay click
    overlay?.addEventListener("click", closeModal);

    // Close modal on Escape key
    document.addEventListener("keydown", (e) => {
      if (
        e.key === "Escape" &&
        modal?.getAttribute("aria-hidden") === "false"
      ) {
        closeModal();
      }
    });
  });
</script>
