---
import BaseHead from "../../components/seo/BaseHead.astro";
import Header from "../../components/layout/Header.astro";
import Footer from "../../components/layout/Footer.astro";
import BlogCard from "./components/BlogCard.astro";
import { getArticles, getCategories, getCategoryCounts } from "../../lib/api";

const PAGE_SIZE = 10;
const page = 1;

const [articlesRes, categories, counts] = await Promise.all([
  getArticles({ page, pageSize: PAGE_SIZE }),
  getCategories(),
  getCategoryCounts(),
]);

const articles = articlesRes.data;
const total = articlesRes.meta.total;
const totalPages = articlesRes.meta.pageCount;
const visible = articles;
---

<!doctype html>
<html lang="es">
  <head>
    <BaseHead
      title="Blog — Miguel Anay"
      description={`${total} escritos sobre código, infra y la forma de construir cosas.`}
    />
  </head>
  <body>
    <Header />

    <main>
      <section class="page-head">
        <div class="page-head__inner">
          <p class="page-head__eyebrow">Blog</p>
          <h1 class="page-head__title">{total} artículos</h1>
          <p class="page-head__lead">Escritos sobre código, infraestructura y la forma de construir cosas. Filtrá por tema o buscá por palabra.</p>
          <form class="search-row" role="search">
            <label class="search" aria-label="Buscar">
              <svg class="search__icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><circle cx="11" cy="11" r="7"></circle><path d="m20 20-3.5-3.5"></path></svg>
              <input
                type="search"
                name="q"
                placeholder="Buscar por título, contenido o tag"
                class="search__input"
              />
              <span class="kbd">⌘K</span>
            </label>
          </form>
        </div>
      </section>

      <section class="filter-section">
        <div class="filter-inner">
          <span class="filter-label">Categorías</span>
          <div class="filter-chips">
            <a href="/blog" class="chip chip--active">
              <span>Todos</span>
              <span class="chip__count chip__count--active">{counts.todos}</span>
            </a>
            {categories.map((cat: any) => (
              <a href={`/blog/category/${cat.slug}`} class="chip">
                <span>{cat.name ?? cat.slug}</span>
                <span class="chip__count">{counts[cat.slug] ?? 0}</span>
              </a>
            ))}
          </div>
        </div>
      </section>

      <section class="posts">
        <div class="posts-inner">
          <div class="posts-head">
            <span class="posts-count">Mostrando {visible.length} de {total}</span>
          </div>

          <ol class="post-list">
            {visible.map((post: any, i: number) => (
              <BlogCard
                title={post.title}
                description={post.description}
                pubDate={new Date(post.publishedAt)}
                slug={post.slug}
                index={i + 1}
                readMin={post.readMin ?? 1}
                categories={post.categories}
              />
            ))}
          </ol>

          {totalPages > 1 && (
            <nav class="pager" aria-label="Paginación">
              <span class="pager__info">Página {page} de {totalPages}</span>
              <div class="pager__nav">
                <span class="pager__disabled">← Anterior</span>
                <span class="pager__active">1</span>
                {totalPages > 1 && <a href="/blog/page/2" class="pager__item">2</a>}
                {totalPages > 2 && <a href="/blog/page/3" class="pager__item">3</a>}
                {totalPages > 3 && <a href="/blog/page/2" class="pager__next">Siguiente →</a>}
              </div>
            </nav>
          )}
        </div>
      </section>
    </main>

    <Footer />

    <style>
      .search-row { margin-top: 24px; }
      .search {
        display: flex;
        align-items: center;
        gap: 10px;
        padding: 8px 12px;
        border: 1px solid var(--border);
        border-radius: var(--radius-full);
        background: var(--bg-raised);
        max-width: 480px;
        color: var(--text-dim);
      }
      .search:focus-within { border-color: var(--border-strong); box-shadow: var(--shadow-subtle); }
      .search__icon { flex-shrink: 0; }
      .search__input {
        flex: 1;
        min-width: 0;
        font-family: var(--font-sans);
        font-size: var(--fs-sm);
        color: var(--text);
        background: transparent;
        border: 0;
        outline: 0;
      }
      .search__input::placeholder { color: var(--text-dim); }

      .filter-section { border-bottom: 1px solid var(--border-dim); }
      .filter-inner {
        max-width: var(--max-w);
        margin: 0 auto;
        padding: 20px var(--pad-x);
        display: flex;
        align-items: center;
        gap: 16px 24px;
        flex-wrap: wrap;
      }
      .filter-label {
        font-size: var(--fs-caption);
        font-weight: 500;
        color: var(--text-muted);
        white-space: nowrap;
      }
      .filter-chips { display: flex; flex-wrap: wrap; gap: 8px; }
      .chip {
        font-size: var(--fs-caption);
        font-weight: 500;
        color: var(--text);
        padding: 5px 12px;
        border: 1px solid var(--border);
        border-radius: var(--radius-full);
        background: var(--bg-raised);
        display: inline-flex;
        align-items: center;
        gap: 6px;
        transition: border-color 0.15s ease;
      }
      .chip:hover { border-color: var(--border-strong); color: var(--text-strong); }
      .chip--active {
        background: var(--primary);
        color: var(--on-primary);
        border-color: var(--primary);
      }
      .chip--active:hover { color: var(--on-primary); }
      .chip__count {
        font-size: var(--fs-micro);
        color: var(--text-dim);
      }
      .chip__count--active { color: var(--on-primary); opacity: 0.7; }

      .posts-inner {
        max-width: var(--max-w);
        margin: 0 auto;
        padding: 32px var(--pad-x) var(--section-pad-y);
      }
      .posts-head { margin-bottom: 8px; }
      .posts-count { font-size: var(--fs-caption); color: var(--text-dim); }
      .post-list { list-style: none; padding: 0; margin: 0; }

      .pager {
        margin-top: 40px;
        padding-top: 24px;
        border-top: 1px solid var(--border-dim);
        display: flex;
        justify-content: space-between;
        align-items: center;
        flex-wrap: wrap;
        gap: 16px;
      }
      .pager__info { font-size: var(--fs-caption); color: var(--text-muted); }
      .pager__nav { display: flex; align-items: center; gap: 4px; font-size: var(--fs-sm); }
      .pager__disabled { color: var(--text-faint); padding: 6px 10px; }
      .pager__active {
        color: var(--on-primary);
        background: var(--primary);
        padding: 4px 12px;
        border-radius: var(--radius-full);
        font-weight: 500;
      }
      .pager__item {
        color: var(--text);
        padding: 4px 12px;
        border: 1px solid var(--border);
        border-radius: var(--radius-full);
      }
      .pager__item:hover { border-color: var(--border-strong); }
      .pager__next { color: var(--text-strong); font-weight: 500; padding: 6px 10px; }
    </style>
  </body>
</html>
