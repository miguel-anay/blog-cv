---
import BaseHead from "../../../components/seo/BaseHead.astro";
import Header from "../../../components/layout/Header.astro";
import Footer from "../../../components/layout/Footer.astro";
import BlogCard from "../components/BlogCard.astro";
import { getArticles } from "../../../lib/api";

const { page } = Astro.params;
if (!page) return Astro.redirect('/blog');
const pageNum = parseInt(page, 10);
if (isNaN(pageNum) || pageNum < 2) return Astro.redirect('/blog');
const { data: articles, meta } = await getArticles({ page: pageNum, pageSize: 10 });
---

<!doctype html>
<html lang="es">
  <head>
    <BaseHead
      title={`Blog — página ${pageNum} — Miguel Anay`}
      description={`Escritos sobre código, infra y la forma de construir cosas. Página ${pageNum}.`}
    />
  </head>
  <body>
    <Header />

    <main>
      <section class="page-head">
        <div class="page-head__inner">
          <p class="page-head__eyebrow">Blog</p>
          <h1 class="page-head__title">Página {pageNum}</h1>
        </div>
      </section>

      <section class="posts">
        <div class="posts-inner">
          <div class="posts-head">
            <span class="posts-count">
              Página {meta.page} de {meta.pageCount} · {meta.total} artículos
            </span>
          </div>

          <ol class="post-list">
            {articles.map((post, i) => (
              <BlogCard
                title={post.title}
                description={post.description ?? ''}
                pubDate={new Date(post.publishedAt ?? post.createdAt)}
                slug={post.slug}
                index={(pageNum - 1) * 10 + i + 1}
                readMin={post.readMin ?? 1}
                categories={post.categories}
              />
            ))}
          </ol>

          <nav class="pager" aria-label="Paginación">
            <span class="pager__info">Página {meta.page} de {meta.pageCount}</span>
            <div class="pager__nav">
              {pageNum > 1 && (
                <a href={pageNum === 2 ? "/blog" : `/blog/page/${pageNum - 1}`} class="pager__item">
                  ← Anterior
                </a>
              )}
              <span class="pager__active">{pageNum}</span>
              {pageNum < meta.pageCount && (
                <a href={`/blog/page/${pageNum + 1}`} class="pager__item">Siguiente →</a>
              )}
            </div>
          </nav>
        </div>
      </section>
    </main>

    <Footer />

    <style>
      .posts-inner { max-width: var(--max-w); margin: 0 auto; padding: 32px var(--pad-x) var(--section-pad-y); }
      .posts-head { margin-bottom: 8px; }
      .posts-count { font-size: var(--fs-caption); color: var(--text-dim); }
      .post-list { list-style: none; padding: 0; margin: 0; }

      .pager {
        margin-top: 40px;
        padding-top: 24px;
        border-top: 1px solid var(--border-dim);
        display: flex;
        justify-content: space-between;
        align-items: center;
        flex-wrap: wrap;
        gap: 16px;
      }
      .pager__info { font-size: var(--fs-caption); color: var(--text-muted); }
      .pager__nav { display: flex; align-items: center; gap: 4px; font-size: var(--fs-sm); }
      .pager__active {
        color: var(--on-primary);
        background: var(--primary);
        padding: 4px 12px;
        border-radius: var(--radius-full);
        font-weight: 500;
      }
      .pager__item {
        color: var(--text);
        padding: 4px 12px;
        border: 1px solid var(--border);
        border-radius: var(--radius-full);
        text-decoration: none;
      }
      .pager__item:hover { border-color: var(--border-strong); color: var(--text-strong); }
    </style>
  </body>
</html>
