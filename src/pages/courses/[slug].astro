---
import BaseHead from '../../components/seo/BaseHead.astro';
import Header from '../../components/layout/Header.astro';
import Footer from '../../components/layout/Footer.astro';
import SectionList from '../../features/courses/components/SectionList.astro';
import CourseNav from '../../features/courses/components/CourseNav.astro';
import { getCourseBySlug } from '../../lib/api';
import { groupSessions } from '../../features/courses/lib/sessions';

const { slug } = Astro.params;
if (!slug) return Astro.redirect('/courses');

const course = await getCourseBySlug(slug);
if (!course) return new Response(null, { status: 404, statusText: 'Not Found' });

const totalResources = (course.sections ?? []).reduce(
  (acc, s) => acc + s.resources.length,
  0,
);

const levelLabel: Record<string, string> = {
  beginner: 'principiante',
  intermediate: 'intermedio',
  advanced: 'avanzado',
};

const isDiplomado = course.type === 'diplomado';
let activeSectionId: number | null = null;

if (isDiplomado && course.sections?.length) {
  const param = Astro.url.searchParams.get('section');
  const parsed = param ? Number(param) : NaN;
  const valid = !isNaN(parsed) && course.sections.some((s) => s.id === parsed);
  activeSectionId = valid ? parsed : course.sections[0].id;
}

const activeSection = isDiplomado
  ? (course.sections ?? []).find((s) => s.id === activeSectionId) ?? null
  : null;
const sessions = groupSessions(activeSection?.resources ?? []);
---

<!doctype html>
<html lang="es">
  <head>
    <BaseHead title={`${course.title} — Cursos`} description={course.description} />
  </head>
  <body>
    <Header />

    <main>
      <section class="course-head">
        <div class="course-head__inner">
          <nav class="breadcrumb" aria-label="Ruta">
            <a href="/courses" class="breadcrumb__back">← Cursos</a>
          </nav>

          <div class="course-meta">
            <span class="course-level">{levelLabel[course.level] ?? course.level}</span>
            <span class="course-sep">·</span>
            <span>{course.sections?.length ?? 0} {isDiplomado ? 'semanas' : 'secciones'}</span>
            <span class="course-sep">·</span>
            <span>{totalResources} recursos</span>
          </div>

          <h1 class="course-title">{course.title}</h1>
          <p class="course-description">{course.description}</p>

          {course.coverUrl && (
            <img
              src={course.coverUrl}
              alt={course.title}
              class="course-cover"
              loading="eager"
            />
          )}
        </div>
      </section>

      <div class="course-body">
        <div class="course-body__inner">
          {(course.sections?.length ?? 0) > 0 && (
            <aside class="course-sidebar" {...(isDiplomado ? { 'data-diplomado': '' } : {})}>
              <CourseNav
                sections={course.sections!}
                activeSectionId={activeSectionId}
                isDiplomado={isDiplomado}
                sessions={sessions}
              />
            </aside>
          )}

          <article class="course-main">
            {(course.sections?.length ?? 0) === 0 ? (
              <p class="empty">Este curso todavía no tiene secciones.</p>
            ) : (
              <SectionList
                sections={course.sections!}
                activeSectionId={activeSectionId}
              />
            )}
          </article>
        </div>
      </div>
    </main>

    <Footer />

    <style>
      .course-head {
        border-bottom: 1px solid var(--border-dim);
      }
      .course-head__inner {
        max-width: var(--max-w);
        margin: 0 auto;
        padding: 40px var(--pad-x) 40px;
      }

      .breadcrumb { margin-bottom: 24px; }
      .breadcrumb__back {
        font-size: var(--fs-sm);
        font-weight: 500;
        color: var(--text-muted);
        text-decoration: none;
      }
      .breadcrumb__back:hover { color: var(--text-strong); }

      .course-meta {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        gap: 8px;
        font-size: var(--fs-caption);
        color: var(--text-muted);
        margin-bottom: 12px;
      }
      .course-level {
        font-size: var(--fs-micro);
        font-weight: 500;
        color: var(--text-muted);
        background: var(--bg-sunken);
        border: 1px solid var(--border);
        border-radius: var(--radius-full);
        padding: 2px 10px;
      }
      .course-sep { color: var(--text-faint); }

      .course-title {
        font-size: var(--fs-h2);
        font-weight: 600;
        line-height: 1.2;
        letter-spacing: -0.5px;
        color: var(--text-strong);
        margin: 0 0 12px;
        max-width: 860px;
      }

      .course-description {
        font-size: var(--fs-lg);
        color: var(--text-muted);
        line-height: 1.5;
        margin: 0;
        max-width: 680px;
      }

      .course-cover {
        width: 100%;
        max-width: 860px;
        height: auto;
        border-radius: var(--radius-lg);
        margin-top: 32px;
        border: 1px solid var(--border);
        object-fit: cover;
      }

      /* Two-column layout */
      .course-body { width: 100%; }

      .course-body__inner {
        max-width: var(--max-w);
        margin: 0 auto;
        padding: 40px var(--pad-x) 96px;
        display: grid;
        grid-template-columns: 240px minmax(0, 1fr);
        gap: 48px;
        align-items: start;
      }

      .course-sidebar {
        display: block;
      }

      .course-main { min-width: 0; }

      .empty {
        font-size: var(--fs-md);
        color: var(--text-dim);
        padding: 48px 0;
        margin: 0;
      }

      @media (max-width: 768px) {
        .course-body__inner {
          grid-template-columns: 1fr;
          gap: 32px;
          padding: 32px var(--pad-x) 64px;
        }
        .course-sidebar {
          border: 1px solid var(--border);
          border-radius: var(--radius-lg);
          padding: 16px;
          background: var(--bg);
        }
        aside[data-diplomado] {
          position: sticky;
          top: 0;
          z-index: 50;
          border-radius: 0;
          padding: 0;
          background: transparent;
          border: none;
        }
      }
    </style>
  </body>
</html>
