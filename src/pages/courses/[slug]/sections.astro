---
import BaseHead from '../../../components/seo/BaseHead.astro';
import Header from '../../../components/layout/Header.astro';
import Footer from '../../../components/layout/Footer.astro';
import SectionCard from '../../../features/courses/components/SectionCard.astro';
import { getCourseBySlug } from '../../../lib/api';

const { slug } = Astro.params;
if (!slug) return Astro.redirect('/courses');

const course = await getCourseBySlug(slug);
if (!course) return new Response(null, { status: 404, statusText: 'Not Found' });

const sections = course.sections ?? [];
---

<!doctype html>
<html lang="es">
  <head>
    <BaseHead
      title={`${course.title} — Secciones`}
      description={`${sections.length} secciones del diplomado ${course.title}.`}
    />
  </head>
  <body>
    <Header />

    <main>
      <section class="course-head">
        <div class="course-head__inner">
          <nav class="breadcrumb" aria-label="Ruta">
            <a href="/courses" class="breadcrumb__back">← Cursos</a>
          </nav>

          <div class="course-meta">
            <span class="course-type">Diplomado</span>
            <span class="course-sep">·</span>
            <span>{sections.length} {sections.length === 1 ? 'sección' : 'secciones'}</span>
          </div>

          <h1 class="course-title">{course.title}</h1>
          {course.description && (
            <p class="course-description">{course.description}</p>
          )}
        </div>
      </section>

      <section class="sections-section">
        <div class="sections-inner">
          {sections.length === 0 ? (
            <p class="empty">Este diplomado todavía no tiene secciones.</p>
          ) : (
            <div class="section-grid">
              {sections.map((section, i) => (
                <SectionCard
                  title={section.title}
                  description={section.description}
                  resourceCount={section.resources.length}
                  href={`/courses/${slug}/?section=${section.id}`}
                  index={i + 1}
                />
              ))}
            </div>
          )}
        </div>
      </section>
    </main>

    <Footer />

    <style>
      .course-head {
        border-bottom: 1px solid var(--border-dim);
      }
      .course-head__inner {
        max-width: var(--max-w);
        margin: 0 auto;
        padding: 40px var(--pad-x) 40px;
      }

      .breadcrumb { margin-bottom: 24px; }
      .breadcrumb__back {
        font-size: var(--fs-sm);
        font-weight: 500;
        color: var(--text-muted);
        text-decoration: none;
      }
      .breadcrumb__back:hover { color: var(--text-strong); }

      .course-meta {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        gap: 8px;
        font-size: var(--fs-caption);
        color: var(--text-muted);
        margin-bottom: 12px;
      }
      .course-type {
        font-size: var(--fs-micro);
        font-weight: 500;
        color: var(--text-muted);
        background: var(--bg-sunken);
        border: 1px solid var(--border);
        border-radius: var(--radius-full);
        padding: 2px 10px;
      }
      .course-sep { color: var(--text-faint); }

      .course-title {
        font-size: var(--fs-h2);
        font-weight: 600;
        line-height: 1.2;
        letter-spacing: -0.5px;
        color: var(--text-strong);
        margin: 0 0 12px;
        max-width: 860px;
      }

      .course-description {
        font-size: var(--fs-lg);
        color: var(--text-muted);
        line-height: 1.5;
        margin: 0;
        max-width: 680px;
      }

      .sections-inner {
        max-width: var(--max-w);
        margin: 0 auto;
        padding: 40px var(--pad-x) 80px;
      }

      .section-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(min(100%, 300px), 1fr));
        gap: 16px;
      }

      .empty {
        font-size: var(--fs-md);
        color: var(--text-dim);
        padding: 48px 0;
        margin: 0;
      }
    </style>
  </body>
</html>
