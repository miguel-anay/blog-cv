---
import BaseHead from '../../components/seo/BaseHead.astro';
import Header from '../../components/layout/Header.astro';
import Footer from '../../components/layout/Footer.astro';
import CourseCard from '../../features/courses/components/CourseCard.astro';
import { getCourses } from '../../lib/api';

const courses = await getCourses();
---

<!doctype html>
<html lang="es">
  <head>
    <BaseHead
      title="Cursos — Miguel Anay"
      description={`${courses.length} cursos sobre desarrollo de software, arquitectura y herramientas.`}
    />
  </head>
  <body>
    <Header />

    <main>
      <section class="page-head">
        <div class="page-head__inner">
          <p class="page-head__eyebrow">Cursos</p>
          <h1 class="page-head__title">
            {courses.length} {courses.length === 1 ? 'curso' : 'cursos'}
          </h1>
          <p class="page-head__lead">Secciones, código y videos sobre desarrollo de software, arquitectura y herramientas.</p>
        </div>
      </section>

      <section class="courses-section">
        <div class="courses-inner">
          {courses.length === 0 ? (
            <p class="empty">No hay cursos publicados todavía.</p>
          ) : (
            <div class="course-grid">
              {courses.map((course) => (
                <CourseCard
                  title={course.title}
                  description={course.description}
                  slug={course.slug}
                  level={course.level}
                  type={course.type}
                  sectionCount={course.sectionCount ?? 0}
                />
              ))}
            </div>
          )}
        </div>
      </section>
    </main>

    <Footer />

    <style>
      .courses-inner {
        max-width: var(--max-w);
        margin: 0 auto;
        padding: 40px var(--pad-x) 80px;
      }

      .course-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(min(100%, 300px), 1fr));
        gap: 16px;
      }

      .empty {
        font-size: var(--fs-md);
        color: var(--text-dim);
        padding: 48px 0;
        margin: 0;
      }
    </style>
  </body>
</html>
