---
import BaseHead from "../components/seo/BaseHead.astro";
import Header from "../components/layout/Header.astro";
import Footer from "../components/layout/Footer.astro";
import { getCv } from "../lib/api";

const cvData = await getCv();

// Fallback if API is unavailable
const personal = cvData?.personal ?? {
  nombre: 'Miguel Anay',
  sitio: 'https://miguel-anay.nom.pe',
  descripcion: 'Software engineer based in Lima, Peru.',
  empresasDestacadas: ['Yiwu Import Corporation'],
  tecnologiasDestacadas: 'TypeScript · Astro · AWS',
  linkedin: 'https://linkedin.com/in/miguelanay',
  anio: String(new Date().getFullYear()),
};
const proyectos = cvData?.proyectos ?? [];
const experiencia = cvData?.experiencia ?? [];
const educacion = cvData?.educacion ?? [];
const cursos = cvData?.cursos ?? [];

// Group cursos by categoria for display
const cursosByCategory = cursos.reduce<Record<string, typeof cursos>>((acc, curso) => {
  if (!acc[curso.categoria]) acc[curso.categoria] = [];
  acc[curso.categoria].push(curso);
  return acc;
}, {});
---

<!doctype html>
<html lang="es">
  <head>
    <BaseHead
      title={`CV — ${personal.nombre}`}
      description={personal.descripcion ?? ''}
    />
  </head>
  <body>
    <Header />

    <main>
      <section class="cv-hero">
        <div class="cv-hero__inner">
          <div class="cv-hero__l">
            <div class="eyebrow">
              <span class="status-dot" aria-hidden="true"></span>
              <span>Disponible · {personal.anio}</span>
            </div>
            <h1 class="cv-name">{personal.nombre}</h1>
            <div class="cv-role">Ingeniero de software · Lima, PE</div>
            <p class="cv-summary">{personal.descripcion}</p>
            <div class="cv-actions">
              <a href="/cv.pdf" class="btn-primary">Descargar PDF</a>
              <a href="/cv.json" class="btn-ghost">JSON Resume</a>
              {personal.linkedin && (
                <a href={personal.linkedin} target="_blank" rel="noopener" class="btn-ghost">LinkedIn →</a>
              )}
            </div>
          </div>
          <div class="cv-hero__r">
            <dl class="cv-facts">
              <div class="cv-facts__row"><dt>Email</dt><dd><a href="mailto:hola@miguel-anay.nom.pe">hola@miguel-anay.nom.pe</a></dd></div>
              {personal.sitio && <div class="cv-facts__row"><dt>Sitio</dt><dd><a href={personal.sitio}>{personal.sitio.replace(/^https?:\/\//, "")}</a></dd></div>}
              {personal.linkedin && <div class="cv-facts__row"><dt>LinkedIn</dt><dd><a href={personal.linkedin} target="_blank" rel="noopener">{personal.linkedin.replace(/^https?:\/\//, "")}</a></dd></div>}
              {personal.empresasDestacadas && personal.empresasDestacadas.length > 0 && (
                <div class="cv-facts__row"><dt>Empresas</dt><dd>{personal.empresasDestacadas.join(" · ")}</dd></div>
              )}
              {personal.tecnologiasDestacadas && (
                <div class="cv-facts__row"><dt>Stack</dt><dd>{personal.tecnologiasDestacadas}</dd></div>
              )}
            </dl>
          </div>
        </div>
      </section>

      {experiencia.length > 0 && (
        <section class="section">
          <div class="section-head">
            <h2 class="section-head__title">Experiencia</h2>
          </div>
          <div class="cv-exp-list">
            {experiencia.map((exp) => (
              <div class="cv-exp-item">
                <div class="cv-exp__l">
                  <div class="cv-exp__period">{exp.periodo}</div>
                  {exp.certificado && (
                    <a href={exp.certificado} target="_blank" rel="noopener" class="cv-exp__cert">Ver certificado ↗</a>
                  )}
                </div>
                <div class="cv-exp__r">
                  <h3 class="cv-exp__role">
                    {exp.cargo}
                    <span class="cv-exp__company">{exp.empresa}</span>
                  </h3>
                  {exp.proyectos && exp.proyectos.length > 0 && (
                    <ul class="cv-exp__bullets">
                      {exp.proyectos.map((p) => (
                        <li>
                          <strong>{p.nombre}.</strong> {p.descripcion}
                        </li>
                      ))}
                    </ul>
                  )}
                  {exp.tecnologias && exp.tecnologias.length > 0 && (
                    <div class="cv-exp__stack">
                      {exp.tecnologias.map((t) => (
                        <span class="cv-exp__tag">{t.trim()}</span>
                      ))}
                    </div>
                  )}
                </div>
              </div>
            ))}
          </div>
        </section>
      )}

      {proyectos.length > 0 && (
        <section class="section">
          <div class="section-head">
            <h2 class="section-head__title">Proyectos</h2>
          </div>
          <div class="cv-proj-grid">
            {proyectos.map((p) => (
              <article class="cv-proj">
                {p.imagen && (
                  <div class="cv-proj__media">
                    <img src={`/paginas/${p.imagen}`} alt={`Screenshot de ${p.titulo}`} loading="lazy" />
                  </div>
                )}
                <div class="cv-proj__body">
                  <div class="cv-proj__header">
                    <h3 class="cv-proj__title">{p.titulo}</h3>
                    {p.empresa && <span class="cv-proj__co">{p.empresa}</span>}
                  </div>
                  {p.descripcion && <p class="cv-proj__desc">{p.descripcion}</p>}
                  {p.tecnologias && p.tecnologias.length > 0 && (
                    <div class="cv-exp__stack">
                      {p.tecnologias.map((t) => (
                        <span class="cv-exp__tag">{t}</span>
                      ))}
                    </div>
                  )}
                  {p.url && (
                    <a href={p.url} target="_blank" rel="noopener" class="cv-proj__link">{p.url.replace(/^https?:\/\//, '')} ↗</a>
                  )}
                </div>
              </article>
            ))}
          </div>
        </section>
      )}

      <section class="section">
        <div class="cv-two-col">
          {educacion.length > 0 && (
            <div>
              <div class="section-head">
                <h2 class="section-head__title">Educación</h2>
              </div>
              <div class="cv-edu">
                {educacion.map((edu) => (
                  <div class="cv-edu-item">
                    <div class="cv-edu__title">{edu.titulo}</div>
                    <div class="cv-edu__place">{edu.institucion}</div>
                    {edu.estado && <div class="cv-edu__estado">{edu.estado}</div>}
                    {edu.certificado && (
                      <a
                        href={edu.certificado}
                        target="_blank"
                        rel="noopener"
                        class="cv-edu__cert"
                      >Ver certificado ↗</a>
                    )}
                  </div>
                ))}
              </div>
            </div>
          )}

          {Object.keys(cursosByCategory).length > 0 && (
            <div>
              <div class="section-head">
                <h2 class="section-head__title">Especializaciones</h2>
              </div>
              <div class="cv-spec">
                {Object.entries(cursosByCategory).map(([cat, items]) => (
                  <details class="cv-spec-item">
                    <summary>
                      <span class="cv-spec__cat">{cat}</span>
                      <span class="cv-spec__count">{items.length} cursos</span>
                    </summary>
                    <ul class="cv-spec__list">
                      {items.map((c) => (
                        <li>
                          <div class="cv-spec__info">
                            <span class="cv-spec__name">{c.nombre}</span>
                            <span class="cv-spec__inst">{c.institucion}{c.fecha ? ` · ${c.fecha}` : ''}</span>
                          </div>
                          {c.certificado && (
                            <a
                              href={c.certificado}
                              target="_blank"
                              rel="noopener"
                              class="cv-spec__cert-link"
                            >Certificado ↗</a>
                          )}
                        </li>
                      ))}
                    </ul>
                  </details>
                ))}
              </div>
            </div>
          )}
        </div>
      </section>
    </main>

    <Footer />

    <script>
      import gsap from 'gsap';
      import { ScrollTrigger } from 'gsap/ScrollTrigger';
      import { registerPlugins } from '../lib/gsap-utils';

      registerPlugins();

      if (!matchMedia('(prefers-reduced-motion: reduce)').matches) {
        gsap.from('.cv-hero__l > *', { autoAlpha: 0, y: 12, stagger: 0.06, duration: 0.4 });
        ScrollTrigger.batch('.cv-exp-item', {
          onEnter: els => gsap.from(els, { y: 16, autoAlpha: 0, stagger: 0.1, duration: 0.45 }),
          once: true,
          start: 'top 92%',
        });
      }
    </script>

    <style>
      .cv-hero { border-bottom: 1px solid var(--border-dim); }
      .cv-hero__inner {
        max-width: var(--max-w);
        margin: 0 auto;
        padding: 72px var(--pad-x) 56px;
        display: grid;
        grid-template-columns: 1.3fr 1fr;
        gap: 48px;
        align-items: center;
      }
      @media (max-width: 900px) {
        .cv-hero__inner { grid-template-columns: 1fr; padding-top: 48px; gap: 32px; }
      }
      .cv-name {
        font-size: clamp(32px, 6vw, var(--fs-h1));
        font-weight: 600;
        line-height: 1.15;
        letter-spacing: -0.025em;
        color: var(--text-strong);
        margin: 20px 0 0;
      }
      .cv-role {
        margin-top: 8px;
        font-size: var(--fs-md);
        font-weight: 500;
        color: var(--accent);
      }
      .cv-summary {
        font-size: var(--fs-lg);
        line-height: 1.55;
        color: var(--text-muted);
        margin: 16px 0 0;
        max-width: 560px;
      }
      .cv-actions { margin-top: 28px; display: flex; gap: 12px; flex-wrap: wrap; }

      .cv-facts {
        margin: 0;
        padding: 8px 20px;
        background: var(--bg-sunken);
        border: 1px solid var(--border);
        border-radius: var(--radius-lg);
      }
      .cv-facts__row {
        display: grid;
        grid-template-columns: 96px 1fr;
        gap: 16px;
        padding: 12px 0;
        border-bottom: 1px solid var(--border);
        font-size: var(--fs-sm);
      }
      .cv-facts__row:last-child { border-bottom: 0; }
      .cv-facts dt { color: var(--text-dim); }
      .cv-facts dd { margin: 0; color: var(--text-strong); overflow-wrap: anywhere; }
      .cv-facts a { color: var(--text-strong); }
      .cv-facts a:hover { color: var(--accent); }

      .cv-exp-list { display: flex; flex-direction: column; }
      .cv-exp-item {
        display: grid;
        grid-template-columns: 200px 1fr;
        gap: 32px;
        padding: 24px 0;
        border-top: 1px solid var(--border);
      }
      @media (max-width: 700px) {
        .cv-exp-item { grid-template-columns: 1fr; gap: 8px; }
      }
      .cv-exp__l { display: flex; flex-direction: column; gap: 6px; }
      .cv-exp__period {
        font-size: var(--fs-sm);
        font-weight: 500;
        color: var(--text-muted);
      }
      .cv-exp__cert {
        font-size: var(--fs-caption);
        color: var(--text-dim);
      }
      .cv-exp__cert:hover { color: var(--accent); }
      .cv-exp__role {
        display: flex;
        flex-direction: column;
        gap: 2px;
        font-size: var(--fs-h5);
        font-weight: 600;
        line-height: 1.3;
        color: var(--text-strong);
        margin: 0 0 12px;
      }
      .cv-exp__company { font-size: var(--fs-sm); font-weight: 500; color: var(--text-muted); }
      .cv-exp__bullets {
        padding-left: 18px;
        margin: 0;
        display: flex;
        flex-direction: column;
        gap: 6px;
      }
      .cv-exp__bullets li {
        font-size: var(--fs-sm);
        line-height: 1.6;
        color: var(--text);
      }
      .cv-exp__bullets li::marker { color: var(--text-faint); }
      .cv-exp__bullets strong { color: var(--text-strong); font-weight: 600; }
      .cv-exp__stack { margin-top: 12px; display: flex; gap: 6px; flex-wrap: wrap; }
      .cv-exp__tag {
        font-size: var(--fs-micro);
        font-weight: 500;
        color: var(--text-muted);
        background: var(--bg-sunken);
        border: 1px solid var(--border);
        border-radius: var(--radius-full);
        padding: 2px 10px;
      }

      .cv-proj-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(min(280px, 100%), 1fr));
        gap: 16px;
      }
      .cv-proj {
        display: flex;
        flex-direction: column;
        background: var(--bg);
        border: 1px solid var(--border);
        border-radius: var(--radius-lg);
        overflow: hidden;
        transition: border-color 0.15s;
      }
      .cv-proj:hover { border-color: var(--border-strong); }
      .cv-proj__media {
        aspect-ratio: 16 / 9;
        background: var(--bg-sunken);
        border-bottom: 1px solid var(--border);
      }
      .cv-proj__media img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        object-position: top center;
        display: block;
      }
      .cv-proj__body {
        padding: 20px;
        display: flex;
        flex-direction: column;
        gap: 8px;
        flex: 1;
      }
      .cv-proj__header {
        display: flex;
        justify-content: space-between;
        align-items: baseline;
        gap: 8px;
        flex-wrap: wrap;
      }
      .cv-proj__title {
        font-size: var(--fs-md);
        font-weight: 600;
        color: var(--text-strong);
        margin: 0;
      }
      .cv-proj__co {
        font-size: var(--fs-caption);
        color: var(--text-dim);
      }
      .cv-proj__desc {
        font-size: var(--fs-sm);
        line-height: 1.55;
        color: var(--text-muted);
        margin: 0;
      }
      .cv-proj__link {
        font-size: var(--fs-caption);
        font-weight: 500;
        color: var(--text-muted);
        margin-top: auto;
        padding-top: 4px;
        overflow-wrap: anywhere;
      }
      .cv-proj__link:hover { color: var(--accent); }

      .cv-two-col {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 48px;
      }
      @media (max-width: 900px) {
        .cv-two-col { grid-template-columns: 1fr; }
      }
      .cv-edu { display: flex; flex-direction: column; }
      .cv-edu-item {
        display: flex;
        flex-direction: column;
        gap: 2px;
        padding: 16px 0;
        border-top: 1px solid var(--border);
      }
      .cv-edu__title {
        font-size: var(--fs-md);
        font-weight: 600;
        color: var(--text-strong);
      }
      .cv-edu__place { font-size: var(--fs-sm); color: var(--text-muted); }
      .cv-edu__estado { font-size: var(--fs-caption); color: var(--text-dim); }
      .cv-edu__cert {
        margin-top: 4px;
        font-size: var(--fs-caption);
        color: var(--text-dim);
      }
      .cv-edu__cert:hover { color: var(--accent); }

      .cv-spec {
        border: 1px solid var(--border);
        border-radius: var(--radius-lg);
        overflow: hidden;
      }
      .cv-spec-item { border-bottom: 1px solid var(--border); }
      .cv-spec-item:last-child { border-bottom: 0; }
      .cv-spec-item summary {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 12px;
        padding: 14px 16px;
        cursor: pointer;
        font-size: var(--fs-sm);
        color: var(--text-strong);
        list-style: none;
      }
      .cv-spec-item summary:hover { background: var(--bg-sunken); }
      .cv-spec-item[open] summary { border-bottom: 1px solid var(--border); }
      .cv-spec-item summary::marker { content: ""; }
      .cv-spec-item summary::-webkit-details-marker { display: none; }
      .cv-spec__cat { font-weight: 500; }
      .cv-spec__count {
        font-size: var(--fs-micro);
        color: var(--text-muted);
        background: var(--bg-sunken);
        border-radius: var(--radius-full);
        padding: 2px 8px;
        white-space: nowrap;
      }
      .cv-spec__list {
        list-style: none;
        margin: 0;
        padding: 4px 16px;
      }
      .cv-spec__list li {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 12px;
        padding: 10px 0;
        border-bottom: 1px solid var(--border-dim);
      }
      .cv-spec__list li:last-child { border-bottom: 0; }
      .cv-spec__info { display: flex; flex-direction: column; gap: 2px; min-width: 0; }
      .cv-spec__name { font-size: var(--fs-sm); color: var(--text); }
      .cv-spec__inst { font-size: var(--fs-caption); color: var(--text-dim); }
      .cv-spec__cert-link {
        flex-shrink: 0;
        font-size: var(--fs-caption);
        font-weight: 500;
        color: var(--text-muted);
      }
      .cv-spec__cert-link:hover { color: var(--accent); }
    </style>
  </body>
</html>
