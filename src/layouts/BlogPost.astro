---
import type { CollectionEntry } from "astro:content";
import BaseHead from "../components/seo/BaseHead.astro";
import Header from "../components/layout/Header.astro";
import Footer from "../components/layout/Footer.astro";
import "../styles/prose.css";

type Props =
  | (CollectionEntry<"blog">["data"] & {
      readMin?: number;
      categorySlug?: string;
      categoryName?: string;
      author?: { name: string; initials: string; meta?: string };
      prev?: { slug: string; title: string };
      next?: { slug: string; title: string };
      slug?: string;
    });

const {
  title,
  description,
  pubDate,
  updatedDate,
  heroImage,
  readMin = 6,
  categories,
  categorySlug: categorySlugProp,
  categoryName: categoryNameProp,
  author = { name: "Miguel Anay", initials: "MA", meta: "Ingeniero · Lima, PE" },
  prev,
  next,
} = Astro.props;

// Articles can arrive with an unparseable updatedAt: show the date only when it is real.
const validUpdated = updatedDate && !Number.isNaN(new Date(updatedDate).getTime()) ? updatedDate : undefined;
const fmt = (d: Date | string | undefined) =>
  d ? new Date(d).toLocaleDateString("es-PE", { year: "numeric", month: "long", day: "numeric" }) : "—";

const categorySlug = categorySlugProp ?? categories?.[0]?.slug;
const categoryName = categoryNameProp ?? categories?.[0]?.name ?? categorySlug;
---

<!doctype html>
<html lang="es">
  <head>
    <BaseHead title={title} description={description ?? undefined} image={heroImage as string | undefined} />
  </head>
  <body>
    <div class="progress-bar" aria-hidden="true"></div>
    <Header />

    <article class="article-shell">
      <!-- ── Article header ─────────────────────────────── -->
      <section class="article-header">
        <div class="article-header__inner">
          <nav class="article-crumb" aria-label="Ruta">
            <a href="/blog">Blog</a>
            {categorySlug && (
              <>
                <span aria-hidden="true">/</span>
                <a href={`/blog/category/${categorySlug}`} class="article-crumb__cat">{categoryName}</a>
              </>
            )}
          </nav>

          <h1 class="article-title">{title}</h1>
          {description && <p class="article-dek">{description}</p>}

          <div class="article-byline">
            <div class="article-author">
              <div class="article-avatar">{author.initials}</div>
              <div>
                <div class="article-author__name">{author.name}</div>
                {author.meta && <div class="article-author__meta">{author.meta}</div>}
              </div>
            </div>
            <div class="article-byline__meta">
              <time datetime={pubDate ? new Date(pubDate).toISOString() : undefined}>{fmt(pubDate)}</time>
              <span class="article-byline__sep">·</span>
              <span>{readMin} min de lectura</span>
              {validUpdated && (
                <>
                  <span class="article-byline__sep">·</span>
                  <span>Actualizado {fmt(validUpdated)}</span>
                </>
              )}
            </div>
          </div>
        </div>
      </section>

      <!-- ── Body: prose + TOC ──────────────────────────── -->
      <section class="article-body">
        <div class="article-body__inner">
          <div class="prose">
            <slot />
          </div>

          <aside class="article-aside">
            <div class="aside-box">
              <div class="aside-box__h">En esta página</div>
              <ol class="toc-list" id="toc-list">
                <li>Cargando…</li>
              </ol>
            </div>
            <div class="aside-box">
              <div class="aside-box__h">Compartir</div>
              <a href={`https://twitter.com/intent/tweet?text=${encodeURIComponent(title)}&url=${encodeURIComponent(Astro.url.toString())}`} target="_blank" rel="noopener" class="aside-box__link">Compartir en X</a>
              <a href={Astro.url.toString()} class="aside-box__link" data-copy-url>Copiar enlace</a>
            </div>
          </aside>
        </div>
      </section>

      <!-- ── Prev / next ────────────────────────────────── -->
      {(prev || next) && (
        <section class="prevnext">
          <div class="prevnext__inner">
            {prev ? (
              <a href={`/blog/${prev.slug}/`} class="prevnext__card">
                <span class="prevnext__label">← Anterior</span>
                <span class="prevnext__title">{prev.title}</span>
              </a>
            ) : <span></span>}
            {next ? (
              <a href={`/blog/${next.slug}/`} class="prevnext__card prevnext__card--next">
                <span class="prevnext__label">Siguiente →</span>
                <span class="prevnext__title">{next.title}</span>
              </a>
            ) : <span></span>}
          </div>
        </section>
      )}
    </article>

    <Footer />

    <style>
      .aside-box__link {
        display: block;
        font-size: var(--fs-caption);
        color: var(--text-muted);
        padding: 4px 0;
      }
      .aside-box__link:hover { color: var(--text-strong); }

      @media (max-width: 767px) {
        .article-aside { display: none; }
      }
    </style>

    <!-- Reading progress bar (vanilla rAF — no GSAP import) -->
    <script>
      {
        const bar = document.querySelector<HTMLElement>('.progress-bar');
        if (bar && !matchMedia('(prefers-reduced-motion: reduce)').matches) {
          let ticking = false;
          const update = () => {
            const scrolled = window.scrollY;
            const total = document.documentElement.scrollHeight - window.innerHeight;
            const p = total > 0 ? Math.min(1, scrolled / total) : 0;
            bar.style.transform = `scaleX(${p})`;
            ticking = false;
          };
          document.addEventListener('scroll', () => {
            if (!ticking) {
              requestAnimationFrame(update);
              ticking = true;
            }
          }, { passive: true });
        }
      }
    </script>

    <!-- TOC builder + copy-url -->
    <script>
      (function () {
        const list = document.getElementById("toc-list");
        const prose = document.querySelector(".prose");
        if (list && prose) {
          const headings = prose.querySelectorAll("h2, h3");
          if (headings.length === 0) {
            list.innerHTML = '<li style="color: var(--text-dim)">(sin secciones)</li>';
          } else {
            list.innerHTML = "";
            headings.forEach((h, i) => {
              if (!h.id) {
                h.id = (h.textContent || `s-${i}`)
                  .toLowerCase()
                  .replace(/[^a-z0-9]+/g, "-")
                  .replace(/^-|-$/g, "");
              }
              const li = document.createElement("li");
              li.innerHTML = `<a href="#${h.id}" style="color: inherit; text-decoration: none">${h.textContent}</a>`;
              if (h.tagName === "H3") li.style.paddingLeft = "12px";
              list.appendChild(li);
            });
          }
        }

        document.querySelectorAll("[data-copy-url]").forEach((el) => {
          el.addEventListener("click", (e) => {
            e.preventDefault();
            const url = (el as HTMLAnchorElement).href;
            navigator.clipboard.writeText(url).then(() => {
              const orig = el.textContent;
              el.textContent = "Copiado";
              setTimeout(() => { el.textContent = orig; }, 1500);
            });
          });
        });
      })();
    </script>
  </body>
</html>
