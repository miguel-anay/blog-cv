---
import { SITE_TITLE } from "../../lib/constants";
import ModeToggle from "../ModeToggle.astro";
import MobileNav from "./MobileNav.astro";

const currentPath = Astro.url.pathname;
const isActive = (href: string) => {
  if (href === "/") return currentPath === "/";
  return currentPath.startsWith(href);
};

const nav = [
  { href: "/blog",    label: "Blog" },
  { href: "/docs",    label: "Docs" },
  { href: "/courses", label: "Cursos" },
  { href: "/exams",   label: "Exámenes" },
  { href: "/about",   label: "Sobre mí" },
  { href: "/cv",      label: "CV" },
];
---

<header class="site-header">
  <div class="site-header__inner">
    <a href="/" class="brand" aria-label={`${SITE_TITLE} — inicio`}>
      <span class="brand__mark" aria-hidden="true"></span>
      <span class="brand__name">Miguel Anay</span>
    </a>

    <nav class="site-nav" aria-label="Navegación principal">
      {nav.map((item) => (
        <a href={item.href} class={isActive(item.href) ? "is-active" : ""} aria-current={isActive(item.href) ? "page" : undefined}>
          {item.label}
        </a>
      ))}
    </nav>

    <div class="header-controls">
      <ModeToggle />
      <MobileNav nav={nav} currentPath={currentPath} />
    </div>
  </div>
</header>
