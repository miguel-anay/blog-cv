---
import { formatHms } from '../lib/timer';

export interface Props {
  title: string;
  description: string;
  slug: string;
  level: string;
  questionCount: number;
  timeLimitSeconds: number;
}

const { title, description, slug, level, questionCount, timeLimitSeconds } = Astro.props;
const href = `/exams/${slug}/`;

const levelLabel: Record<string, string> = {
  beginner: 'principiante',
  intermediate: 'intermedio',
  advanced: 'avanzado',
};
---

<a href={href} class="exam-card">
  <div class="exam-card__meta">
    <span class="exam-card__badge">{levelLabel[level] ?? level}</span>
    <span>{questionCount} {questionCount === 1 ? 'pregunta' : 'preguntas'}</span>
    <span class="exam-card__sep">·</span>
    <span>{formatHms(timeLimitSeconds)}</span>
  </div>
  <h3 class="exam-card__title">{title}</h3>
  <p class="exam-card__desc">{description}</p>
</a>

<style>
  .exam-card {
    display: flex;
    flex-direction: column;
    gap: 10px;
    padding: 24px;
    background: var(--bg);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    text-decoration: none;
    color: inherit;
    transition: border-color 0.15s ease, box-shadow 0.15s ease;
  }
  .exam-card:hover {
    border-color: var(--border-strong);
    box-shadow: var(--shadow-subtle);
  }

  .exam-card__meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 6px;
    font-size: var(--fs-caption);
    color: var(--text-muted);
  }
  .exam-card__sep { color: var(--text-faint); }

  .exam-card__badge {
    font-size: var(--fs-micro);
    font-weight: 500;
    color: var(--text-muted);
    background: var(--bg-sunken);
    border: 1px solid var(--border);
    border-radius: var(--radius-full);
    padding: 2px 10px;
  }

  .exam-card__title {
    font-size: var(--fs-h5);
    font-weight: 600;
    line-height: 1.35;
    letter-spacing: -0.01em;
    color: var(--text-strong);
    margin: 0;
  }

  .exam-card__desc {
    font-size: var(--fs-sm);
    line-height: 1.55;
    color: var(--text-muted);
    margin: 0;
  }
</style>
