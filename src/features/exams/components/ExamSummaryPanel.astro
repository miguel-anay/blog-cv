---
// Dual-use component (per design):
//   - variant="overlay": client-only "Quiz Summary" overlay during an attempt.
//     Rendered hidden; attempt-controller.ts (Phase 4) toggles it open and
//     reuses the navigator's already-known state (no fetch). The final submit
//     action lives here, not in AttemptToolbar — REQ-006.
//   - variant="results": static, server-rendered results panel — no JS.
// No client script is added in this phase; only markup + data-* hooks.

import type { ExamResultQuestion } from '../../../lib/api-types';

export interface QuizSummaryQuestionState {
  index: number;
  answered: boolean;
  flagged: boolean;
}

interface OverlayProps {
  variant: 'overlay';
  totalQuestions: number;
  initialStates?: QuizSummaryQuestionState[];
}

interface ResultsProps {
  variant: 'results';
  score: number;
  correctCount: number;
  totalQuestions: number;
  passScorePercent: number;
  passed: boolean;
  questions: ExamResultQuestion[];
}

export type Props = OverlayProps | ResultsProps;

const props = Astro.props;
const { variant, totalQuestions } = props;

const overlayStates: QuizSummaryQuestionState[] =
  variant === 'overlay'
    ? (() => {
        const byIndex = new Map((props.initialStates ?? []).map((s) => [s.index, s]));
        return Array.from({ length: totalQuestions }, (_, i) => {
          const index = i + 1;
          return byIndex.get(index) ?? { index, answered: false, flagged: false };
        });
      })()
    : [];
---

{variant === 'overlay' ? (
  <div class="exam-summary" data-exam-summary-overlay hidden>
    <div class="exam-summary__panel" role="dialog" aria-label="Resumen del examen">
      <div class="exam-summary__header">
        <h2 class="exam-summary__title">Resumen del examen</h2>
        <button type="button" class="exam-summary__close" data-action="close-summary" aria-label="Cerrar resumen">
          &times;
        </button>
      </div>

      <ol class="exam-summary__grid">
        {overlayStates.map((q) => (
          <li>
            <button
              type="button"
              class="exam-summary__jump"
              data-question-index={q.index}
              data-answered={q.answered}
              data-flagged={q.flagged}
            >
              {q.index}
            </button>
          </li>
        ))}
      </ol>

      <div class="exam-summary__actions">
        <button type="button" class="exam-summary__secondary" data-action="close-summary">
          Seguir respondiendo
        </button>
        <button type="button" class="exam-summary__submit" data-action="submit-exam">
          Enviar examen
        </button>
      </div>
    </div>
  </div>
) : (
  <div class="exam-results">
    <div class={`exam-results__badge ${props.passed ? 'is-pass' : 'is-fail'}`}>
      {props.passed ? 'Aprobado' : 'No aprobado'}
    </div>
    <div class="exam-results__score">
      <span class="exam-results__score-value">{props.score}%</span>
      <span class="exam-results__score-detail">
        {props.correctCount} de {props.totalQuestions} correctas · mínimo para aprobar {props.passScorePercent}%
      </span>
    </div>

    <ol class="exam-results__questions">
      {props.questions.map((q) => (
        <li class={`exam-results__question ${q.isCorrect ? 'is-correct' : 'is-incorrect'}`}>
          <div class="exam-results__question-top">
            <span class="exam-results__question-num">Pregunta {q.order}</span>
            <span class="exam-results__question-status">
              {q.isCorrect ? '✓ Correcta' : '✗ Incorrecta'}
            </span>
          </div>
          <p class="exam-results__question-prompt">{q.prompt}</p>
          <ul class="exam-results__options">
            {q.options.map((option) => (
              <li
                class={`exam-results__option ${option.isCorrect ? 'is-correct-option' : ''} ${
                  option.id === q.selectedOptionId ? 'is-selected' : ''
                }`}
              >
                {option.text}
              </li>
            ))}
          </ul>
          {q.explanation && <p class="exam-results__explanation">{q.explanation}</p>}
        </li>
      ))}
    </ol>
  </div>
)}

<style>
  /* Semantic status colors (pass / fail / flagged), readable on both canvases. */
  .exam-summary,
  .exam-results {
    --ok: #15803d;
    --ok-soft: rgba(21, 128, 61, 0.08);
    --bad: #dc2626;
    --bad-soft: rgba(220, 38, 38, 0.08);
    --flag: #b45309;
  }
  :global(html[data-mode='dark']) .exam-summary,
  :global(html[data-mode='dark']) .exam-results {
    --ok: #4ade80;
    --ok-soft: rgba(74, 222, 128, 0.1);
    --bad: #f87171;
    --bad-soft: rgba(248, 113, 113, 0.1);
    --flag: #fbbf24;
  }

  /* ── Overlay variant ─────────────────────────────────────── */
  .exam-summary {
    position: fixed;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    background: rgba(10, 10, 10, 0.45);
    z-index: 200;
    padding: 16px;
  }

  /* Author `display` beats the UA `[hidden]` rule; keep the overlay hideable. */
  .exam-summary[hidden] {
    display: none;
  }

  .exam-summary__panel {
    display: flex;
    flex-direction: column;
    gap: 20px;
    width: 100%;
    max-width: 520px;
    max-height: 80vh;
    overflow-y: auto;
    background: var(--bg);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-card);
    padding: 24px;
  }

  .exam-summary__header {
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .exam-summary__title {
    font-size: var(--fs-h5);
    font-weight: 600;
    color: var(--text-strong);
    margin: 0;
  }

  .exam-summary__close {
    font-family: inherit;
    font-size: 20px;
    line-height: 1;
    color: var(--text-muted);
    background: transparent;
    border: none;
    border-radius: var(--radius-full);
    cursor: pointer;
    padding: 4px 10px;
  }

  .exam-summary__close:hover {
    color: var(--text-strong);
    background: var(--bg-sunken);
  }

  .exam-summary__grid {
    list-style: none;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(36px, 1fr));
    gap: 6px;
    padding: 0;
    margin: 0;
  }

  .exam-summary__jump {
    width: 100%;
    aspect-ratio: 1;
    display: flex;
    align-items: center;
    justify-content: center;
    font-family: inherit;
    font-size: var(--fs-caption);
    font-weight: 500;
    font-variant-numeric: tabular-nums;
    color: var(--text-muted);
    background: var(--bg);
    border: 1px solid var(--border);
    border-radius: var(--radius-md);
    cursor: pointer;
  }

  .exam-summary__jump:hover {
    border-color: var(--border-strong);
  }

  .exam-summary__jump[data-answered='true'] {
    background: var(--accent-soft);
    color: var(--accent);
    border-color: transparent;
  }

  .exam-summary__jump[data-flagged='true'] {
    border-color: var(--flag);
    box-shadow: inset 0 0 0 1px var(--flag);
  }

  .exam-summary__actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: flex-end;
    gap: 8px;
  }

  .exam-summary__secondary,
  .exam-summary__submit {
    font-family: inherit;
    font-size: var(--fs-sm);
    font-weight: 500;
    line-height: 1.3;
    border-radius: var(--radius-full);
    padding: 10px 20px;
    cursor: pointer;
    transition: opacity 0.15s, border-color 0.15s;
  }

  .exam-summary__secondary {
    color: var(--text-strong);
    background: var(--bg);
    border: 1px solid var(--border);
  }

  .exam-summary__secondary:hover {
    border-color: var(--border-strong);
  }

  .exam-summary__submit {
    color: var(--accent-on);
    background: var(--accent-bright);
    border: 1px solid var(--accent-bright);
  }

  .exam-summary__submit:hover {
    opacity: 0.88;
  }

  .exam-summary__secondary:disabled,
  .exam-summary__submit:disabled {
    opacity: 0.5;
    cursor: not-allowed;
  }

  /* ── Results variant ─────────────────────────────────────── */
  .exam-results {
    display: flex;
    flex-direction: column;
    gap: 24px;
  }

  .exam-results__badge {
    display: inline-flex;
    align-self: flex-start;
    font-size: var(--fs-caption);
    font-weight: 500;
    padding: 4px 12px;
    border-radius: var(--radius-full);
  }

  .exam-results__badge.is-pass {
    color: var(--ok);
    background: var(--ok-soft);
    border: 1px solid var(--ok);
  }

  .exam-results__badge.is-fail {
    color: var(--bad);
    background: var(--bad-soft);
    border: 1px solid var(--bad);
  }

  .exam-results__score {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .exam-results__score-value {
    font-size: var(--fs-h1);
    font-weight: 600;
    line-height: 1.1;
    color: var(--text-strong);
    letter-spacing: -1px;
    font-variant-numeric: tabular-nums;
  }

  .exam-results__score-detail {
    font-size: var(--fs-sm);
    color: var(--text-muted);
  }

  .exam-results__questions {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 12px;
    padding: 0;
    margin: 0;
  }

  .exam-results__question {
    display: flex;
    flex-direction: column;
    gap: 10px;
    padding: 20px;
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    background: var(--bg);
  }

  .exam-results__question-top {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 8px;
    font-size: var(--fs-caption);
    color: var(--text-muted);
  }

  .exam-results__question-status {
    font-weight: 500;
  }

  .exam-results__question.is-correct .exam-results__question-status {
    color: var(--ok);
  }

  .exam-results__question.is-incorrect .exam-results__question-status {
    color: var(--bad);
  }

  .exam-results__question-prompt {
    font-size: var(--fs-md);
    font-weight: 600;
    color: var(--text-strong);
    margin: 0;
    line-height: 1.45;
  }

  .exam-results__options {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 6px;
    padding: 0;
    margin: 0;
  }

  .exam-results__option {
    font-size: var(--fs-sm);
    line-height: 1.5;
    color: var(--text-muted);
    padding: 8px 12px;
    border: 1px solid var(--border);
    border-radius: var(--radius-md);
  }

  .exam-results__option.is-correct-option {
    border-color: var(--ok);
    background: var(--ok-soft);
    color: var(--ok);
  }

  .exam-results__option.is-selected {
    font-weight: 600;
  }

  .exam-results__option.is-selected:not(.is-correct-option) {
    border-color: var(--bad);
    background: var(--bad-soft);
    color: var(--bad);
  }

  .exam-results__explanation {
    font-size: var(--fs-sm);
    color: var(--text-muted);
    line-height: 1.6;
    margin: 0;
    padding-top: 10px;
    border-top: 1px solid var(--border-dim);
  }
</style>
