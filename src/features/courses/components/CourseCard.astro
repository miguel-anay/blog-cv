---
export interface Props {
  title: string;
  description: string;
  slug: string;
  level: string;
  sectionCount: number;
  type: 'course' | 'diplomado';
}

const { title, description, slug, level, sectionCount, type } = Astro.props;
const href = type === 'diplomado' ? `/courses/${slug}/sections/` : `/courses/${slug}/`;

const levelLabel: Record<string, string> = {
  beginner: 'principiante',
  intermediate: 'intermedio',
  advanced: 'avanzado',
};
---

<a href={href} class="course-card">
  <div class="course-card__meta">
    <span class="course-card__badge">{levelLabel[level] ?? level}</span>
    {type === 'diplomado' && <span class="course-card__badge">Diplomado</span>}
    <span>{sectionCount} {sectionCount === 1 ? 'sección' : 'secciones'}</span>
  </div>
  <h3 class="course-card__title">{title}</h3>
  <p class="course-card__desc">{description}</p>
</a>

<style>
  .course-card {
    display: flex;
    flex-direction: column;
    gap: 10px;
    padding: 24px;
    background: var(--bg);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    text-decoration: none;
    color: inherit;
    transition: border-color 0.15s ease, box-shadow 0.15s ease;
  }
  .course-card:hover {
    border-color: var(--border-strong);
    box-shadow: var(--shadow-subtle);
  }

  .course-card__meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 6px;
    font-size: var(--fs-caption);
    color: var(--text-muted);
  }

  .course-card__badge {
    font-size: var(--fs-micro);
    font-weight: 500;
    color: var(--text-muted);
    background: var(--bg-sunken);
    border: 1px solid var(--border);
    border-radius: var(--radius-full);
    padding: 2px 10px;
  }

  .course-card__title {
    font-size: var(--fs-h5);
    font-weight: 600;
    line-height: 1.35;
    letter-spacing: -0.01em;
    color: var(--text-strong);
    margin: 0;
  }

  .course-card__desc {
    font-size: var(--fs-sm);
    line-height: 1.55;
    color: var(--text-muted);
    margin: 0;
  }
</style>
