---
import type { CourseResource } from '../../../lib/api-types';

export interface Props {
  resource: CourseResource;
  anchorId?: string;
}

const { resource, anchorId } = Astro.props;

function getVideoEmbed(url: string): string | null {
  const yt = url.match(/(?:youtube\.com\/watch\?v=|youtu\.be\/)([a-zA-Z0-9_-]{11})/);
  if (yt) return `https://www.youtube-nocookie.com/embed/${yt[1]}`;
  const vimeo = url.match(/vimeo\.com\/(\d+)/);
  if (vimeo) return `https://player.vimeo.com/video/${vimeo[1]}`;
  return null;
}

const embedUrl = resource.type === 'video' ? getVideoEmbed(resource.url) : null;

const badge = resource.type === 'github' ? 'GitHub' : resource.type === 'video' ? 'Video' : 'Enlace';
---

<div class="resource" id={anchorId ?? undefined}>
  {embedUrl && (
    <div class="resource__embed">
      <iframe
        src={embedUrl}
        title={resource.title}
        allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
        allowfullscreen
        loading="lazy"
      />
    </div>
  )}
  <div class="resource__row">
    <span class={`resource__badge resource__badge--${resource.type}`}>{badge}</span>
    <div class="resource__info">
      <a href={resource.url} target="_blank" rel="noopener noreferrer" class="resource__title">
        {resource.title}
      </a>
      {resource.description && <p class="resource__desc">{resource.description}</p>}
    </div>
  </div>
</div>

<style>
  .resource {
    display: flex;
    flex-direction: column;
    gap: 12px;
    padding: 14px 16px;
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    background: var(--bg);
    scroll-margin-top: 100px;
  }

  .resource__embed {
    position: relative;
    width: 100%;
    padding-bottom: 56.25%;
    border-radius: var(--radius-md);
    overflow: hidden;
    background: #000;
  }
  .resource__embed iframe {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    border: 0;
  }

  .resource__row {
    display: flex;
    align-items: flex-start;
    gap: 12px;
  }

  .resource__badge {
    font-size: var(--fs-micro);
    font-weight: 500;
    padding: 1px 8px;
    border-radius: var(--radius-full);
    white-space: nowrap;
    flex-shrink: 0;
    margin-top: 1px;
    background: var(--bg-sunken);
    color: var(--text-muted);
    border: 1px solid var(--border);
  }
  .resource__badge--link {
    background: var(--accent-soft);
    color: var(--accent);
    border-color: transparent;
  }

  .resource__info { display: flex; flex-direction: column; gap: 4px; min-width: 0; }

  .resource__title {
    font-size: var(--fs-sm);
    font-weight: 500;
    color: var(--text-strong);
    text-decoration: none;
    line-height: 1.4;
    overflow-wrap: anywhere;
  }
  .resource__title:hover { color: var(--link); }

  .resource__desc {
    font-size: var(--fs-caption);
    color: var(--text-muted);
    margin: 0;
    line-height: 1.5;
  }
</style>
