---
import type { CourseSession } from '../../../lib/api-types';

export interface Props {
  session: CourseSession;
}

const { session } = Astro.props;

function getVideoEmbed(url: string): string | null {
  const yt = url.match(/(?:youtube\.com\/watch\?v=|youtu\.be\/)([a-zA-Z0-9_-]{11})/);
  if (yt) return `https://www.youtube-nocookie.com/embed/${yt[1]}`;
  const vimeo = url.match(/vimeo\.com\/(\d+)/);
  if (vimeo) return `https://player.vimeo.com/video/${vimeo[1]}`;
  return null;
}

const embedUrl = session.video ? getVideoEmbed(session.video.url) : null;

const badge = (type: string) =>
  type === 'github' ? 'GitHub' : type === 'video' ? 'Video' : 'Enlace';
---

<div class="session-block" id={session.anchorId}>
  <div class="session-block__header">
    <span class="session-block__num">Sesión {session.number}</span>
    <h2 class="session-block__title">{session.title}</h2>
  </div>

  {embedUrl && (
    <div class="session-block__embed">
      <iframe
        src={embedUrl}
        title={session.video!.title}
        allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
        allowfullscreen
        loading="lazy"
      />
    </div>
  )}

  {session.video && !embedUrl && (
    <a href={session.video.url} target="_blank" rel="noopener noreferrer" class="session-block__video-link">
      <span class="session-block__badge session-block__badge--video">Video</span>
      {session.video.title}
    </a>
  )}

  {session.materials.length > 0 && (
    <details class="session-materials">
      <summary class="session-materials__toggle">
        <span>Material</span>
        <span class="session-materials__count">{session.materials.length}</span>
      </summary>
      <div class="session-materials__list">
        {session.materials.map((m) => (
          <a href={m.url} target="_blank" rel="noopener noreferrer" class="session-materials__item">
            <span class={`session-block__badge session-block__badge--${m.type}`}>{badge(m.type)}</span>
            <span class="session-materials__label">{m.title}</span>
          </a>
        ))}
      </div>
    </details>
  )}
</div>

<style>
  .session-block {
    padding: 32px 0 40px;
    border-bottom: 1px solid var(--border-dim);
    scroll-margin-top: 100px;
  }
  .session-block:first-child { padding-top: 0; }
  .session-block:last-child { border-bottom: none; }

  .session-block__header {
    display: flex;
    flex-direction: column;
    gap: 6px;
    margin-bottom: 20px;
  }

  .session-block__num {
    font-size: var(--fs-caption);
    font-weight: 500;
    color: var(--accent);
  }

  .session-block__title {
    font-size: var(--fs-h4);
    font-weight: 600;
    letter-spacing: -0.01em;
    color: var(--text-strong);
    margin: 0;
    line-height: 1.3;
  }

  .session-block__embed {
    position: relative;
    width: 100%;
    padding-bottom: 56.25%;
    border-radius: var(--radius-lg);
    border: 1px solid var(--border);
    overflow: hidden;
    background: #000;
    margin-bottom: 16px;
  }
  .session-block__embed iframe {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    border: 0;
  }

  .session-block__video-link {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 12px 16px;
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    background: var(--bg);
    text-decoration: none;
    color: var(--text-strong);
    font-size: var(--fs-sm);
    font-weight: 500;
    margin-bottom: 16px;
    transition: border-color 0.15s ease;
  }
  .session-block__video-link:hover { border-color: var(--border-strong); }

  /* Accordion */
  .session-materials {
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    background: var(--bg);
    overflow: hidden;
  }

  .session-materials__toggle {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 12px 16px;
    cursor: pointer;
    font-size: var(--fs-sm);
    font-weight: 500;
    color: var(--text-strong);
    list-style: none;
    user-select: none;
  }
  .session-materials__toggle::-webkit-details-marker { display: none; }
  .session-materials__toggle::before {
    content: '›';
    font-size: var(--fs-md);
    line-height: 1;
    color: var(--text-dim);
    transition: transform 0.15s;
  }
  details[open] .session-materials__toggle::before {
    transform: rotate(90deg);
  }
  .session-materials__count {
    background: var(--bg-sunken);
    border: 1px solid var(--border);
    color: var(--text-dim);
    padding: 0 8px;
    border-radius: var(--radius-full);
    font-size: var(--fs-micro);
  }

  .session-materials__list {
    display: flex;
    flex-direction: column;
    padding: 4px 0 8px;
    border-top: 1px solid var(--border);
  }

  .session-materials__item {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 8px 16px;
    text-decoration: none;
    color: var(--text-muted);
    font-size: var(--fs-sm);
    transition: color 0.12s, background 0.12s;
  }
  .session-materials__item:hover {
    color: var(--text-strong);
    background: var(--bg-sunken);
  }
  .session-materials__label { flex: 1; min-width: 0; overflow-wrap: anywhere; }

  /* Badges */
  .session-block__badge {
    font-size: var(--fs-micro);
    font-weight: 500;
    padding: 1px 8px;
    border-radius: var(--radius-full);
    white-space: nowrap;
    flex-shrink: 0;
    background: var(--bg-sunken);
    color: var(--text-muted);
    border: 1px solid var(--border);
  }
  .session-block__badge--link {
    background: var(--accent-soft);
    color: var(--accent);
    border-color: transparent;
  }

  @media (max-width: 767px) {
    .session-block { scroll-margin-top: 60px; }
    .session-block__title { font-size: var(--fs-h5); }
  }
</style>
