---
import type { CourseSection, CourseSession } from '../../../lib/api-types';

export interface Props {
  sections: CourseSection[];
  activeSectionId?: number | null;
  isDiplomado?: boolean;
  sessions?: CourseSession[];
}

const { sections, activeSectionId = null, isDiplomado = false, sessions = [] } = Astro.props;

const showSessions = isDiplomado && sessions.length > 0;
---

<nav
  class="course-nav"
  aria-label={isDiplomado ? 'Cursos del diplomado' : 'Secciones del curso'}
  data-mode={isDiplomado ? 'diplomado' : 'course'}
>
  <details class="course-nav__details" open>
    <summary class="course-nav__label">
      <span>{showSessions ? 'Sesiones' : isDiplomado ? 'Cursos' : 'Secciones'}</span>
      <span class="course-nav__chevron" aria-hidden="true">▾</span>
    </summary>

  {showSessions ? (
    <ol class="course-nav__list">
      {sessions.map((session) => (
        <li>
          <a
            href={`#${session.anchorId}`}
            class="course-nav__item"
            data-section={session.anchorId}
          >
            <span class="course-nav__num">{session.number}</span>
            <span class="course-nav__title">{session.title}</span>
          </a>
        </li>
      ))}
    </ol>
  ) : (
    <ol class="course-nav__list">
      {sections.map((section, i) => (
        <li>
          <a
            href={isDiplomado ? `?section=${section.id}` : `#section-${section.id}`}
            class:list={[
              'course-nav__item',
              isDiplomado
                ? activeSectionId === section.id && 'is-active'
                : false,
            ]}
            data-section={`section-${section.id}`}
          >
            <span class="course-nav__num">{i + 1}</span>
            <span class="course-nav__title">{section.title}</span>
            {section.resources.length > 0 && (
              <span class="course-nav__badge">{section.resources.length}</span>
            )}
          </a>
        </li>
      ))}
    </ol>
  )}
  </details>
</nav>

<script>
  const nav = document.querySelector<HTMLElement>('.course-nav');
  const mode = nav?.dataset.mode;

  if (mode === 'course') {
    const navItems = document.querySelectorAll<HTMLAnchorElement>('.course-nav__item');
    const sections = document.querySelectorAll<HTMLElement>('.course-section');

    if (navItems.length && sections.length) {
      const observer = new IntersectionObserver(
        (entries) => {
          for (const entry of entries) {
            if (!entry.isIntersecting) continue;
            const id = entry.target.id;
            navItems.forEach((a) => {
              a.classList.toggle('is-active', a.dataset.section === id);
            });
          }
        },
        { rootMargin: '-20% 0px -70% 0px', threshold: 0 },
      );
      sections.forEach((s) => observer.observe(s));
    }
  } else if (mode === 'diplomado') {
    const navItems = document.querySelectorAll<HTMLAnchorElement>(
      '.course-nav__item[data-section^="session-"]',
    );
    const blocks = document.querySelectorAll<HTMLElement>('.session-block[id^="session-"]');

    if (navItems.length && blocks.length) {
      const observer = new IntersectionObserver(
        (entries) => {
          for (const entry of entries) {
            if (!entry.isIntersecting) continue;
            const id = entry.target.id;
            navItems.forEach((a) => {
              a.classList.toggle('is-active', a.dataset.section === id);
            });
          }
        },
        { rootMargin: '-10% 0px -80% 0px', threshold: 0 },
      );
      blocks.forEach((b) => observer.observe(b));
    }
  }
</script>

<style>
  .course-nav {
    position: sticky;
    top: 80px;
    display: flex;
    flex-direction: column;
    gap: 12px;
    max-height: calc(100vh - 120px);
    overflow-y: auto;
    scrollbar-width: thin;
    scrollbar-color: var(--border) transparent;
  }

  .course-nav__details { display: contents; }

  .course-nav__label {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: var(--fs-caption);
    font-weight: 600;
    color: var(--text-strong);
    padding-bottom: 10px;
    border-bottom: 1px solid var(--border);
    list-style: none;
    cursor: default;
  }
  .course-nav__label::-webkit-details-marker { display: none; }

  .course-nav__chevron { display: none; margin-left: auto; }

  .course-nav__list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .course-nav__item {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 6px 10px;
    border-radius: var(--radius-md);
    text-decoration: none;
    color: var(--text-muted);
    font-size: var(--fs-sm);
    line-height: 1.4;
    transition: color 0.12s, background 0.12s;
  }
  .course-nav__item:hover {
    color: var(--text-strong);
    background: var(--bg-sunken);
  }
  .course-nav__item.is-active {
    color: var(--accent);
    font-weight: 500;
    background: var(--accent-soft);
  }

  .course-nav__num {
    color: var(--text-faint);
    flex-shrink: 0;
    min-width: 1.25em;
    font-size: var(--fs-micro);
    font-variant-numeric: tabular-nums;
  }
  .course-nav__item.is-active .course-nav__num { color: var(--accent); }

  .course-nav__title { flex: 1; }

  .course-nav__badge {
    font-size: var(--fs-micro);
    background: var(--bg-sunken);
    border: 1px solid var(--border);
    color: var(--text-dim);
    padding: 0 6px;
    border-radius: var(--radius-full);
    flex-shrink: 0;
  }
  .course-nav__item.is-active .course-nav__badge {
    color: var(--accent);
  }

  /* Mobile */
  @media (max-width: 767px) {
    /* Diplomado: vertical sticky nav */
    .course-nav[data-mode="diplomado"] {
      position: sticky;
      top: 0;
      z-index: 50;
      max-height: 50vh;
      overflow-y: auto;
      flex-direction: column;
      background: var(--bg);
      border-bottom: 1px solid var(--border);
      border-radius: 0;
      gap: 4px;
      padding: 12px 0;
    }

    .course-nav[data-mode="diplomado"] .course-nav__list {
      flex-direction: column;
      overflow-x: visible;
    }

    .course-nav[data-mode="diplomado"] .course-nav__item {
      white-space: normal;
    }

    /* Regular course: compact vertical list */
    .course-nav[data-mode="course"] {
      max-height: 50vh;
      overflow-y: auto;
    }

    /* Collapsible listview */
    .course-nav__details { display: block; }
    .course-nav__label {
      cursor: pointer;
      border-bottom: none;
      padding-bottom: 0;
    }
    .course-nav__chevron {
      display: inline-block;
      transition: transform 0.15s;
    }
    .course-nav__details[open] .course-nav__chevron { transform: rotate(180deg); }
    .course-nav__details[open] .course-nav__label {
      border-bottom: 1px solid var(--border);
      padding-bottom: 10px;
      margin-bottom: 4px;
    }
    .course-nav[data-mode="diplomado"] {
      max-height: none;
    }
    .course-nav[data-mode="diplomado"] .course-nav__details[open] {
      max-height: 50vh;
      overflow-y: auto;
      display: block;
    }
  }
</style>
