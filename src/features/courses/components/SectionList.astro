---
import { marked } from 'marked';
import type { CourseSection } from '../../../lib/api-types';
import ResourceItem from './ResourceItem.astro';
import SessionBlock from './SessionBlock.astro';
import { groupSessions } from '../lib/sessions';

export interface Props {
  sections: CourseSection[];
  activeSectionId?: number | null;
}

const { sections, activeSectionId = null } = Astro.props;
const visibleSections = activeSectionId !== null
  ? sections.filter((s) => s.id === activeSectionId)
  : sections;

marked.setOptions({ gfm: true, breaks: true });
---

<div class="sections">
  {visibleSections.map((section, i) => (
    <div class="course-section" id={`section-${section.id}`}>
      <div class="section__header">
        <div class="section__meta">
          <span class="section__num">Sección {i + 1}</span>
          <h2 class="section__title">{section.title}</h2>
          {section.description && (
            <p class="section__desc">{section.description}</p>
          )}
        </div>
        {section.resources.length > 0 && (
          <span class="section__count">
            {section.resources.length} {section.resources.length === 1 ? 'recurso' : 'recursos'}
          </span>
        )}
      </div>

      {section.content && (
        <div class="section__content prose" set:html={marked.parse(section.content)} />
      )}

      {section.resources.length > 0 && (() => {
        const sessions = groupSessions(section.resources);
        const ungrouped = section.resources.filter((r) => r.sessionNumber == null);
        return (
          <>
            {sessions.length > 0 && (
              <div class="section__sessions">
                {sessions.map((session) => (
                  <SessionBlock session={session} />
                ))}
              </div>
            )}
            {(sessions.length === 0 || ungrouped.length > 0) && (
              <div class="section__resources">
                <span class="section__resources-label">Recursos</span>
                <div class="section__resources-list">
                  {(sessions.length > 0 ? ungrouped : section.resources).map((resource) => (
                    <ResourceItem resource={resource} anchorId={`resource-${resource.id}`} />
                  ))}
                </div>
              </div>
            )}
          </>
        );
      })()}
    </div>
  ))}
</div>

<style>
  .sections { display: flex; flex-direction: column; gap: 0; }

  .course-section {
    padding: 40px 0;
    border-bottom: 1px solid var(--border-dim);
    scroll-margin-top: 100px;
  }
  .course-section:first-child { padding-top: 0; }
  .course-section:last-child { border-bottom: none; }

  .section__header {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: start;
    gap: 16px;
    margin-bottom: 24px;
  }

  .section__num {
    font-size: var(--fs-caption);
    font-weight: 500;
    color: var(--accent);
  }

  .section__meta { display: flex; flex-direction: column; gap: 6px; min-width: 0; }

  .section__title {
    font-size: var(--fs-h4);
    font-weight: 600;
    letter-spacing: -0.01em;
    color: var(--text-strong);
    margin: 0;
    line-height: 1.3;
  }

  .section__desc {
    font-size: var(--fs-md);
    color: var(--text-muted);
    margin: 0;
    line-height: 1.5;
  }

  .section__count {
    font-size: var(--fs-micro);
    font-weight: 500;
    color: var(--text-muted);
    background: var(--bg-sunken);
    border: 1px solid var(--border);
    border-radius: var(--radius-full);
    padding: 2px 10px;
    white-space: nowrap;
  }

  /* Markdown content */
  .section__content {
    margin-bottom: 32px;
  }

  .prose :global(h2),
  .prose :global(h3) {
    font-weight: 600;
    color: var(--text-strong);
    margin: 1.5em 0 0.5em;
  }
  .prose :global(h2) { font-size: var(--fs-h5); }
  .prose :global(h3) { font-size: var(--fs-md); }

  .prose :global(p),
  .prose :global(ul),
  .prose :global(ol) {
    font-size: var(--fs-md);
    line-height: 1.5;
    color: var(--text);
    margin: 0 0 1em;
  }
  .prose :global(ul),
  .prose :global(ol) { padding-left: 1.25em; }

  .prose :global(code) {
    font-family: var(--font-mono);
    font-size: 0.875em;
    background: var(--bg-sunken);
    border: 1px solid var(--border);
    color: var(--text-strong);
    padding: 1px 6px;
    border-radius: var(--radius-xs);
  }

  .prose :global(pre) {
    background: var(--code-bg);
    border-radius: var(--radius-md);
    padding: 16px;
    overflow-x: auto;
    margin: 0 0 1em;
  }
  .prose :global(pre code) {
    background: none;
    border: 0;
    color: var(--code-text);
    padding: 0;
    font-size: var(--fs-caption);
  }

  .prose :global(blockquote) {
    border-left: 2px solid var(--border-strong);
    padding: 2px 0 2px 16px;
    margin: 0 0 1em;
    color: var(--text-muted);
    font-size: var(--fs-md);
  }

  .prose :global(strong) { color: var(--text-strong); font-weight: 600; }

  .prose :global(a) { color: var(--link); text-decoration: underline; text-underline-offset: 2px; }

  /* Sessions (diplomado with session_number) */
  .section__sessions { display: flex; flex-direction: column; }

  /* Resources (fallback flat list) */
  .section__resources-label {
    display: block;
    font-size: var(--fs-caption);
    font-weight: 600;
    color: var(--text-strong);
    margin-bottom: 12px;
  }

  .section__resources-list { display: flex; flex-direction: column; gap: 8px; }
</style>
