---
export interface Props {
  title: string;
  description?: string | null;
  resourceCount: number;
  href: string;
  index?: number;
}

const { title, description, resourceCount, href, index } = Astro.props;
const label = index != null ? `Sección ${index}` : '';
---

<a href={href} class="section-card">
  <div class="section-card__top">
    {label && <span class="section-card__num">{label}</span>}
    <span class="section-card__count">
      {resourceCount} {resourceCount === 1 ? 'recurso' : 'recursos'}
    </span>
  </div>
  <h3 class="section-card__title">{title}</h3>
  {description && <p class="section-card__desc">{description}</p>}
</a>

<style>
  .section-card {
    display: flex;
    flex-direction: column;
    gap: 10px;
    padding: 24px;
    background: var(--bg);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    text-decoration: none;
    color: inherit;
    transition: border-color 0.15s ease, box-shadow 0.15s ease;
  }
  .section-card:hover {
    border-color: var(--border-strong);
    box-shadow: var(--shadow-subtle);
  }

  .section-card__top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    font-size: var(--fs-caption);
  }

  .section-card__num {
    font-weight: 500;
    color: var(--accent);
  }

  .section-card__count {
    color: var(--text-muted);
  }

  .section-card__title {
    font-size: var(--fs-h5);
    font-weight: 600;
    line-height: 1.35;
    letter-spacing: -0.01em;
    color: var(--text-strong);
    margin: 0;
  }

  .section-card__desc {
    font-size: var(--fs-sm);
    line-height: 1.55;
    color: var(--text-muted);
    margin: 0;
  }
</style>
