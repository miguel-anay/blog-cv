---
// Decorative canvas for the homepage hero. Gates on reduced-motion and WebGL
// support BEFORE the dynamic import, so the three.js chunk is never fetched
// by users who can't or shouldn't run it. The ONLY importer of ../three.
---

<canvas class="hero-canvas" aria-hidden="true"></canvas>

<style>
  .hero-canvas {
    position: absolute;
    inset: 0;
    /* Explicit, and load-bearing. A <canvas>'s width/height ATTRIBUTES are CSS
       presentational hints, so with no author rule setting a size they win over
       `inset: 0` and the element lays out at its drawing-buffer size. stage.ts
       sets those attributes to css-size x devicePixelRatio (setSize's third arg
       is false, i.e. "do not touch style"), so on a DPR-2 phone the canvas laid
       out at twice its box and the scene rendered cropped to the top-left
       quarter. On a DPR-1 desktop the two happen to match, which is why this
       never showed up there. */
    width: 100%;
    height: 100%;
    z-index: 0;
    pointer-events: none;
  }
</style>

<script>
  const canvas = document.querySelector<HTMLCanvasElement>(".hero-canvas");

  function hasWebGL(): boolean {
    try {
      const probe = document.createElement("canvas");
      return !!(probe.getContext("webgl2") || probe.getContext("webgl"));
    } catch {
      return false;
    }
  }

  if (canvas && !matchMedia("(prefers-reduced-motion: reduce)").matches && hasWebGL()) {
    const load = () =>
      import("../three")
        .then((m) => m.init(canvas))
        .catch(() => {});

    if ("requestIdleCallback" in window) {
      requestIdleCallback(load, { timeout: 2000 });
    } else {
      setTimeout(load, 300);
    }
  }
</script>
