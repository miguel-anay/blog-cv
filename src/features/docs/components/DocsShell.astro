---
// Docs page shell — Mintlify documentation layout: sidebar nav · prose · "On this page" TOC.
import BaseHead from '../../../components/seo/BaseHead.astro';
import Header from '../../../components/layout/Header.astro';
import Footer from '../../../components/layout/Footer.astro';
import { buildTree, docSlug, docTitle, extractTitle, type TocItem } from '../lib/github-docs';
import type { DocRepo } from '../repos';

interface Props {
  repo: DocRepo;
  /** Docs-relative markdown paths, in tree order. */
  docFiles: string[];
  /** Current docs-relative path, undefined for the README intro. */
  current?: string;
  html: string;
  toc: TocItem[];
  sourcePath: string;
  lastModified: Date | null;
}

const { repo, docFiles, current, html, toc, sourcePath, lastModified } = Astro.props;
const navLabel = (path?: string) => (path ? docTitle(path) : 'Introducción');
// The document's own h1 beats the file name ("Método" instead of "Metodo").
const pageTitle = extractTitle(html) ?? navLabel(current);
const base = `/docs/${repo.repo}`;
const editUrl = `https://github.com/${repo.owner}/${repo.repo}/blob/HEAD/${sourcePath}`;
const href = (path: string) => `${base}/${docSlug(path)}`;
const tree = buildTree(docFiles);

// Reading order for prev/next follows the sidebar.
const pages = [{ href: base, label: navLabel(), active: !current }].concat(
  tree.filter((r) => r.kind === 'file').map((r) => ({ href: href(r.path!), label: navLabel(r.path), active: r.path === current })),
);
const index = pages.findIndex((p) => p.active);
const prev = pages[index - 1];
const next = pages[index + 1];
const updated = lastModified?.toLocaleDateString('es-PE', { year: 'numeric', month: 'long', day: 'numeric' });
---

<!doctype html>
<html lang="es">
  <head>
    <BaseHead title={`${pageTitle} — ${repo.title} docs`} description={repo.description} />
  </head>
  <body>
    <Header />

    <main class="docs">
      <aside class="docs-side" aria-label={`Documentación de ${repo.title}`}>
        <a href="/docs" class="docs-side__back">← Todas las docs</a>
        <p class="docs-side__repo">{repo.title}</p>

        <!-- Open by default (desktop, no-JS); the script below collapses it on small screens. -->
        <details id="docs-tree-panel" class="docs-side__panel" open>
          <summary class="docs-side__toggle">
            <span>Menú</span>
            <span class="docs-side__current">{navLabel(current)}</span>
          </summary>

          <div class="docs-search">
            <svg class="docs-search__icon" viewBox="0 0 16 16" width="14" height="14" aria-hidden="true"><path fill="currentColor" d="M11.5 7a4.5 4.5 0 1 1-9 0 4.5 4.5 0 0 1 9 0Zm-.82 4.74a6 6 0 1 1 1.06-1.06l3.04 3.04a.75.75 0 1 1-1.06 1.06l-3.04-3.04Z"/></svg>
            <input id="docs-search" type="search" placeholder="Buscar" autocomplete="off" aria-label="Buscar en la documentación" />
            <kbd class="docs-search__kbd">/</kbd>
            <ul id="docs-search-results" class="docs-search__results" hidden></ul>
          </div>

          <p class="docs-side__section">Empezar</p>
          <ul class="docs-nav">
            <li>
              <a href={base} class={!current ? 'is-active' : ''} aria-current={!current ? 'page' : undefined}>{navLabel()}</a>
            </li>
          </ul>

          {tree.length > 0 && <p class="docs-side__section">Guías</p>}
          <ul class="docs-nav">
            {tree.map((row) =>
              row.kind === 'dir' ? (
                <li class="docs-nav__dir" style={`--depth:${row.depth}`}>{row.name.replace(/\/$/, '')}</li>
              ) : (
                <li style={`--depth:${row.depth}`}>
                  <a href={href(row.path!)} class={row.path === current ? 'is-active' : ''} aria-current={row.path === current ? 'page' : undefined}>
                    {navLabel(row.path)}
                  </a>
                </li>
              ),
            )}
          </ul>
        </details>
      </aside>

      <article class="docs-body">
        <nav class="docs-crumb" aria-label="Ruta">
          <a href="/docs">Docs</a>
          <span aria-hidden="true">/</span>
          <a href={base}>{repo.title}</a>
        </nav>

        <div class="docs-prose" set:html={html} />

        <footer class="docs-foot">
          <div class="docs-foot__meta">
            <a href={editUrl} rel="noopener">Editar en GitHub ↗</a>
            {lastModified && (
              <span>Actualizado el <time datetime={lastModified.toISOString()}>{updated}</time></span>
            )}
          </div>
          <div class="docs-foot__pager">
            {prev ? (
              <a href={prev.href} class="docs-pager"><small>Anterior</small><span>← {prev.label}</span></a>
            ) : <span />}
            {next && (
              <a href={next.href} class="docs-pager docs-pager--next"><small>Siguiente</small><span>{next.label} →</span></a>
            )}
          </div>
        </footer>
      </article>

      {toc.length > 0 && (
        <aside class="docs-toc" aria-label="En esta página">
          <p class="docs-toc__title">En esta página</p>
          <ul>
            {toc.map((t) => (
              <li class={`d${t.depth}`}><a href={`#${t.id}`}>{t.text}</a></li>
            ))}
          </ul>
        </aside>
      )}
    </main>

    <Footer />

    <style>
      .docs {
        max-width: var(--max-w);
        margin: 0 auto;
        padding: 40px var(--pad-x) 64px;
        display: grid;
        grid-template-columns: 240px minmax(0, 720px) 200px;
        justify-content: space-between;
        gap: 48px;
        align-items: start;
      }

      /* ── Sidebar ─────────────────────────────────────── */
      .docs-side, .docs-toc {
        position: sticky;
        top: 96px;
        max-height: calc(100vh - 120px);
        overflow-y: auto;
        font-size: var(--fs-sm);
      }
      .docs-side__back { font-size: var(--fs-caption); color: var(--text-dim); }
      .docs-side__back:hover { color: var(--text-strong); }
      .docs-side__repo { margin: 12px 0 16px; font-size: var(--fs-md); font-weight: 600; color: var(--text-strong); }
      .docs-side__section {
        margin: 20px 0 6px;
        padding: 0 12px;
        font-size: 11px;
        font-weight: 600;
        letter-spacing: 0.5px;
        text-transform: uppercase;
        color: var(--text-muted);
      }
      .docs-nav { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 2px; }
      .docs-nav li { padding-left: calc(var(--depth, 0) * 12px); }
      .docs-nav a {
        display: block;
        padding: 6px 12px;
        border-radius: var(--radius-sm);
        color: var(--text-muted);
        line-height: 1.4;
      }
      .docs-nav a:hover { color: var(--text-strong); background: var(--bg-sunken); }
      .docs-nav a.is-active {
        color: var(--text-strong);
        font-weight: 500;
        background: var(--bg-sunken);
        box-shadow: inset 2px 0 0 var(--accent-bright);
      }
      .docs-nav__dir { padding: 10px 12px 4px; font-size: var(--fs-caption); font-weight: 500; color: var(--text-dim); }

      .docs-side__toggle { display: none; }

      /* Search pill (Mintlify search-pill) */
      .docs-search {
        position: relative;
        display: flex;
        align-items: center;
        gap: 8px;
        height: 36px;
        padding: 0 10px;
        margin-bottom: 4px;
        background: var(--bg-sunken);
        border: 1px solid var(--border);
        border-radius: var(--radius-md);
        color: var(--text-dim);
      }
      .docs-search:focus-within { border-color: var(--accent-bright); background: var(--bg); }
      .docs-search input { flex: 1; min-width: 0; background: transparent; border: 0; outline: 0; color: var(--text); font: inherit; font-size: var(--fs-sm); }
      .docs-search__kbd {
        font-family: var(--font-mono);
        font-size: 11px;
        padding: 1px 6px;
        border: 1px solid var(--border);
        border-radius: var(--radius-xs);
        background: var(--bg);
        color: var(--text-dim);
      }
      .docs-search__results {
        position: absolute;
        top: calc(100% + 6px);
        left: 0;
        right: 0;
        z-index: 10;
        list-style: none;
        margin: 0;
        padding: 4px;
        background: var(--bg);
        border: 1px solid var(--border);
        border-radius: var(--radius-md);
        box-shadow: var(--shadow-card);
        max-height: 320px;
        overflow-y: auto;
      }
      .docs-search__results :global(a) { display: block; padding: 8px 10px; border-radius: var(--radius-sm); color: var(--text-strong); font-size: var(--fs-sm); }
      .docs-search__results :global(a):hover, .docs-search__results :global(a):focus { background: var(--bg-sunken); outline: 0; }
      .docs-search__results :global(small) { display: block; color: var(--text-dim); font-size: var(--fs-micro); }
      .docs-search__results :global(.empty) { padding: 8px 10px; color: var(--text-dim); }

      /* ── Article ─────────────────────────────────────── */
      .docs-crumb { display: flex; gap: 8px; font-size: var(--fs-caption); color: var(--text-dim); margin-bottom: 16px; }
      .docs-crumb a { color: var(--text-muted); }
      .docs-crumb a:hover { color: var(--text-strong); }

      .docs-prose { font-size: var(--fs-md); line-height: 1.6; color: var(--text); }
      .docs-prose :global(> *:first-child) { margin-top: 0; }
      .docs-prose :global(.markdown-heading) { position: relative; }
      .docs-prose :global(.anchor) { display: none; }
      .docs-prose :global(h1) { font-size: var(--fs-h3); font-weight: 600; line-height: 1.25; letter-spacing: -0.3px; color: var(--text-strong); margin: 0 0 16px; }
      .docs-prose :global(h2) { font-size: var(--fs-h4); font-weight: 600; line-height: 1.3; color: var(--text-strong); margin: 40px 0 12px; scroll-margin-top: 88px; }
      .docs-prose :global(h3) { font-size: var(--fs-h5); font-weight: 600; line-height: 1.4; color: var(--text-strong); margin: 32px 0 8px; scroll-margin-top: 88px; }
      .docs-prose :global(h4) { font-size: var(--fs-md); font-weight: 600; color: var(--text-strong); margin: 24px 0 8px; }
      .docs-prose :global(p), .docs-prose :global(ul), .docs-prose :global(ol) { margin: 0 0 16px; }
      .docs-prose :global(ul), .docs-prose :global(ol) { padding-left: 24px; }
      .docs-prose :global(li) { margin: 4px 0; }
      .docs-prose :global(li::marker) { color: var(--text-dim); }
      .docs-prose :global(a) { color: var(--text-strong); font-weight: 500; text-decoration: underline; text-decoration-color: var(--accent-bright); text-decoration-thickness: 1px; text-underline-offset: 3px; }
      .docs-prose :global(a:hover) { text-decoration-thickness: 2px; }
      .docs-prose :global(strong) { color: var(--text-strong); font-weight: 600; }
      .docs-prose :global(hr) { margin: 32px 0; }
      .docs-prose :global(img) { max-width: 100%; height: auto; border-radius: var(--radius-lg); }
      .docs-prose :global(blockquote) { margin: 0 0 16px; padding: 4px 16px; border-left: 2px solid var(--border-strong); color: var(--text-muted); }

      /* Inline code (Mintlify code-inline) */
      .docs-prose :global(:not(pre) > code) {
        font-family: var(--font-mono);
        font-size: var(--fs-caption);
        font-weight: 500;
        padding: 2px 6px;
        border-radius: var(--radius-xs);
        border: 1px solid var(--border);
        background: var(--bg-sunken);
        color: var(--text-strong);
      }
      /* Code blocks (Mintlify code-block) */
      .docs-prose :global(pre) {
        margin: 0 0 20px;
        padding: 16px;
        overflow-x: auto;
        background: var(--code-bg);
        color: var(--code-text);
        border-radius: var(--radius-md);
        font-family: var(--font-mono);
        font-size: var(--fs-sm);
        line-height: 1.6;
      }
      .docs-prose :global(.highlight) { margin: 0 0 20px; }
      .docs-prose :global(.highlight pre) { margin: 0; }

      /* GitHub syntax classes on the dark code surface */
      .docs-prose :global(.pl-c) { color: #8b8b8f; font-style: italic; }
      .docs-prose :global(.pl-k) { color: #ff7b72; }
      .docs-prose :global(.pl-s), .docs-prose :global(.pl-pds) { color: #a5d6ff; }
      .docs-prose :global(.pl-c1), .docs-prose :global(.pl-v) { color: #79c0ff; }
      .docs-prose :global(.pl-en) { color: #d2a8ff; }
      .docs-prose :global(.pl-smi) { color: #ffffff; }
      .docs-prose :global(.pl-ent) { color: #7ee787; }

      /* Tables */
      .docs-prose :global(table) { display: block; width: 100%; overflow-x: auto; border-collapse: collapse; margin: 0 0 20px; font-size: var(--fs-sm); }
      .docs-prose :global(th) { text-align: left; font-weight: 600; color: var(--text-strong); background: var(--bg-sunken); }
      .docs-prose :global(th), .docs-prose :global(td) { border: 1px solid var(--border); padding: 8px 12px; vertical-align: top; }

      /* GitHub alerts: > [!NOTE] / [!TIP] / [!IMPORTANT] / [!WARNING] / [!CAUTION] */
      .docs-prose :global(.markdown-alert) { --alert: #3772cf; margin: 0 0 20px; padding: 12px 16px; border: 1px solid var(--border); border-left: 3px solid var(--alert); border-radius: var(--radius-md); background: var(--bg-sunken); }
      .docs-prose :global(.markdown-alert-tip) { --alert: var(--accent); }
      .docs-prose :global(.markdown-alert-important) { --alert: #8250df; }
      .docs-prose :global(.markdown-alert-warning) { --alert: #c37d0d; }
      .docs-prose :global(.markdown-alert-caution) { --alert: #d45656; }
      .docs-prose :global(.markdown-alert-title) { display: flex; align-items: center; gap: 8px; margin: 0 0 4px; font-size: var(--fs-sm); font-weight: 600; color: var(--alert); }
      .docs-prose :global(.markdown-alert-title svg) { fill: currentColor; }
      .docs-prose :global(.markdown-alert > :last-child) { margin-bottom: 0; }

      /* ── Footer of the article ───────────────────────── */
      .docs-foot { margin-top: 56px; padding-top: 20px; border-top: 1px solid var(--border-dim); font-size: var(--fs-sm); }
      .docs-foot__meta { display: flex; justify-content: space-between; gap: 16px; flex-wrap: wrap; color: var(--text-dim); }
      .docs-foot__meta a { color: var(--text-muted); }
      .docs-foot__meta a:hover { color: var(--text-strong); }
      .docs-foot__pager { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; margin-top: 24px; }
      .docs-pager {
        display: flex;
        flex-direction: column;
        gap: 2px;
        padding: 14px 16px;
        border: 1px solid var(--border);
        border-radius: var(--radius-lg);
        color: var(--text-strong);
        font-weight: 500;
        transition: border-color 0.15s ease;
      }
      .docs-pager:hover { border-color: var(--border-strong); color: var(--text-strong); }
      .docs-pager small { font-size: var(--fs-caption); font-weight: 400; color: var(--text-dim); }
      .docs-pager--next { grid-column: 2; text-align: right; }

      /* ── TOC ─────────────────────────────────────────── */
      .docs-toc__title { margin: 0 0 10px; font-size: var(--fs-caption); font-weight: 600; color: var(--text-strong); }
      .docs-toc ul { list-style: none; margin: 0; padding: 0; border-left: 1px solid var(--border-dim); }
      .docs-toc li a { display: block; padding: 4px 0 4px 12px; margin-left: -1px; color: var(--text-muted); line-height: 1.4; border-left: 1px solid transparent; }
      .docs-toc li.d3 a { padding-left: 24px; }
      .docs-toc li a:hover { color: var(--text-strong); border-left-color: var(--accent-bright); }

      /* ── Responsive (Mintlify collapsing strategy) ───── */
      @media (max-width: 1100px) {
        .docs { grid-template-columns: 220px minmax(0, 1fr); gap: 40px; }
        .docs-toc { display: none; }
      }
      @media (max-width: 767px) {
        .docs { grid-template-columns: minmax(0, 1fr); padding: 20px 16px 48px; gap: 20px; }
        .docs-side { position: static; max-height: none; }
        .docs-side__back, .docs-side__repo { display: none; }
        .docs-side__toggle {
          display: flex;
          align-items: center;
          gap: 8px;
          padding: 10px 14px;
          cursor: pointer;
          list-style: none;
          border: 1px solid var(--border);
          border-radius: var(--radius-md);
          font-weight: 500;
          color: var(--text-strong);
        }
        .docs-side__toggle::-webkit-details-marker { display: none; }
        .docs-side__toggle::after { content: '▾'; margin-left: auto; color: var(--text-dim); }
        .docs-side__panel[open] .docs-side__toggle { margin-bottom: 12px; }
        .docs-side__panel[open] .docs-side__toggle::after { content: '▴'; }
        .docs-side__current { color: var(--text-muted); font-weight: 400; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
        .docs-foot__pager { grid-template-columns: 1fr; }
        .docs-pager--next { grid-column: 1; }
      }
    </style>

    <script>
      // Collapse the docs nav on small screens so the article comes first.
      const panel = document.getElementById('docs-tree-panel') as HTMLDetailsElement | null;
      if (panel && window.matchMedia('(max-width: 767px)').matches) panel.open = false;

      // Client-side search over /docs/search.json (loaded on first focus). "/" focuses the box.
      type Entry = { repo: string; title: string; url: string; headings: string[] };
      const input = document.getElementById('docs-search') as HTMLInputElement | null;
      const list = document.getElementById('docs-search-results') as HTMLUListElement | null;
      let index: Promise<Entry[]> | null = null;
      const load = (): Promise<Entry[]> => (index ??= fetch('/docs/search.json').then((r) => (r.ok ? r.json() : [])).catch(() => []));
      const esc = (s: string) => s.replace(/[&<>"]/g, (c) => `&${({ '&': 'amp', '<': 'lt', '>': 'gt', '"': 'quot' } as Record<string, string>)[c]};`);

      async function render() {
        if (!input || !list) return;
        const q = input.value.trim().toLowerCase();
        if (!q) { list.hidden = true; return; }
        const hits = (await load()).filter((e) => `${e.repo} ${e.title} ${e.headings.join(' ')}`.toLowerCase().includes(q)).slice(0, 8);
        list.innerHTML = hits.length
          ? hits.map((e) => `<li><a href="${esc(e.url)}">${esc(e.title)}<small>${esc(e.repo)}</small></a></li>`).join('')
          : '<li class="empty">Sin resultados</li>';
        list.hidden = false;
      }

      input?.addEventListener('focus', load);
      input?.addEventListener('input', render);
      input?.addEventListener('keydown', (ev) => { if (ev.key === 'Escape') { input.value = ''; render(); input.blur(); } });
      document.addEventListener('keydown', (ev) => {
        const typing = ev.target instanceof HTMLInputElement || ev.target instanceof HTMLTextAreaElement;
        if (ev.key === '/' && !typing) { ev.preventDefault(); if (panel) panel.open = true; input?.focus(); }
      });
      document.addEventListener('click', (ev) => { if (list && !list.parentElement?.contains(ev.target as Node)) list.hidden = true; });
    </script>
  </body>
</html>
